[run]
branch = True
parallel = True
include =
    */omniopt
    */omniopt_optuna
    */omniopt_plot
    */omniopt_docker
    */omniopt_evaluate
    */omniopt_share
    */.helpers.py
    */.optuna_runner.py
    */.tpe.py
    */.random_generator.py
    */.pareto.py
    */.shellscript_functions.py
    */.colorfunctions.py
    */.general.py
    */.omniopt_plot_*.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:

# The Docker test measures the same source tree mounted at /var/opt/omniopt.
# Map that (and any other checkout location) back to the repository-relative
# paths so combined reports contain one entry per file and generated reports
# are portable across CI jobs and machines.
[paths]
omniopt =
    omniopt
    */omniopt
omniopt_optuna =
    omniopt_optuna
    */omniopt_optuna
omniopt_plot =
    omniopt_plot
    */omniopt_plot
omniopt_docker =
    omniopt_docker
    */omniopt_docker
omniopt_evaluate =
    omniopt_evaluate
    */omniopt_evaluate
omniopt_share =
    omniopt_share
    */omniopt_share
helpers =
    .helpers.py
    */.helpers.py
optuna_runner =
    .optuna_runner.py
    */.optuna_runner.py
tpe =
    .tpe.py
    */.tpe.py
random_generator =
    .random_generator.py
    */.random_generator.py
pareto =
    .pareto.py
    */.pareto.py
shellscript_functions =
    .shellscript_functions.py
    */.shellscript_functions.py
colorfunctions =
    .colorfunctions.py
    */.colorfunctions.py
general =
    .general.py
    */.general.py
omniopt_plot_cpu_ram_usage =
    .omniopt_plot_cpu_ram_usage.py
    */.omniopt_plot_cpu_ram_usage.py
omniopt_plot_general =
    .omniopt_plot_general.py
    */.omniopt_plot_general.py
omniopt_plot_gpu_usage =
    .omniopt_plot_gpu_usage.py
    */.omniopt_plot_gpu_usage.py
omniopt_plot_kde =
    .omniopt_plot_kde.py
    */.omniopt_plot_kde.py
omniopt_plot_scatter_generation_method =
    .omniopt_plot_scatter_generation_method.py
    */.omniopt_plot_scatter_generation_method.py
omniopt_plot_scatter_hex =
    .omniopt_plot_scatter_hex.py
    */.omniopt_plot_scatter_hex.py
omniopt_plot_scatter =
    .omniopt_plot_scatter.py
    */.omniopt_plot_scatter.py
omniopt_plot_time_and_exit_code =
    .omniopt_plot_time_and_exit_code.py
    */.omniopt_plot_time_and_exit_code.py
omniopt_plot_trial_index_result =
    .omniopt_plot_trial_index_result.py
    */.omniopt_plot_trial_index_result.py
omniopt_plot_worker =
    .omniopt_plot_worker.py
    */.omniopt_plot_worker.py
