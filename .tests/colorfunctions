#!/usr/bin/env bash

# HELPPAGE: Tests the color-functions library (.colorfunctions.sh / .colorfunctions.py).

{
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

cd "$SCRIPT_DIR"

cd ..

export OO_MAIN_TESTS=1

errors=()

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
NC=$'\033[0m'

function red_text {
	echo -ne "${RED}$1${NC}"
}

function green_text {
	echo -e "${GREEN}$1${NC}"
}

function yellow_text {
	echo -e "${YELLOW}$1${NC}"
}

if [[ -e .colorfunctions.py ]]; then
	MODE="python"
else
	MODE="bash"
fi

run_function() {
	# run_function "FUNCTION" "ARGUMENTS..."  ->  captures STDOUT into RET_OUT and STDERR into RET_ERR
	if [[ "$MODE" == "bash" ]]; then
		source .colorfunctions.sh
		RET_OUT="$( $1 "$2" 2>/dev/null )"
		RET_ERR="$( $1 "$2" 2>&1 >/dev/null )"
	else
		RET_OUT="$( python3 .colorfunctions.py "$1" "$2" 2>/dev/null )"
		RET_ERR="$( python3 .colorfunctions.py "$1" "$2" 2>&1 >/dev/null )"
	fi
}

check_result() {
	# check_result "NAME" "GOT" "EXPECTED" "STREAM(0=stdout,1=stderr)"
	local name="$1"
	local got="$2"
	local expected="$3"
	local stream="$4"

	if [[ "$got" != "$expected" ]]; then
		red_text "FAIL: $name (stream $stream)\n"
		red_text "  expected: $(printf '%q' "$expected")\n"
		red_text "  got:      $(printf '%q' "$got")\n"
		errors+=("$name (stream $stream)")
	fi
}

# --- plain echoerr (stderr, newline, no color) ---
run_function "echoerr" "plain message"
check_result "echoerr-stdout" "$RET_OUT" "" "stdout"
check_result "echoerr-stderr" "$RET_ERR" "plain message" "stderr"

# --- red_text (stdout, no newline, red) ---
run_function "red_text" "hello"
check_result "red_text-stdout" "$RET_OUT" $'\033[0;31mhello\033[0m' "stdout"
check_result "red_text-stderr" "$RET_ERR" "" "stderr"

# --- green (stdout, no newline, green) ---
run_function "green" "hello"
check_result "green-stdout" "$RET_OUT" $'\033[0;32mhello\033[0m' "stdout"
check_result "green-stderr" "$RET_ERR" "" "stderr"

# --- green_text (stderr, newline, green) ---
run_function "green_text" "hello"
check_result "green_text-stdout" "$RET_OUT" "" "stdout"
check_result "green_text-stderr" "$RET_ERR" $'\033[0;32mhello\033[0m' "stderr"

# --- green_text_no_newline (stderr, no newline, green) ---
run_function "green_text_no_newline" "hello"
check_result "green_text_no_newline-stdout" "$RET_OUT" "" "stdout"
check_result "green_text_no_newline-stderr" "$RET_ERR" $'\033[0;32mhello\033[0m' "stderr"

# --- yellow_text (stderr, newline, yellow; note the double-ESC quirk) ---
run_function "yellow_text" "hello"
check_result "yellow_text-stdout" "$RET_OUT" "" "stdout"
check_result "yellow_text-stderr" "$RET_ERR" $'\e\033[0;33mhello\e[0m' "stderr"

# --- _green_text_bold_underline (stderr, newline) ---
run_function "_green_text_bold_underline" "hello"
check_result "_green_text_bold_underline-stdout" "$RET_OUT" "" "stdout"
check_result "_green_text_bold_underline-stderr" "$RET_ERR" $'\033[1;4;32mhello\033[0m' "stderr"

# --- green_reset_line (stdout, \r + clear-line + green) ---
run_function "green_reset_line" "hello"
check_result "green_reset_line-stdout" "$RET_OUT" $'\r\033[K\033[0;32mhello\033[0m' "stdout"
check_result "green_reset_line-stderr" "$RET_ERR" "" "stderr"

# --- red_reset_line (stdout, \r + clear-line + red) ---
run_function "red_reset_line" "hello"
check_result "red_reset_line-stdout" "$RET_OUT" $'\r\033[K\033[0;31mhello\033[0m' "stdout"
check_result "red_reset_line-stderr" "$RET_ERR" "" "stderr"

# --- _tput cr ---
run_function "_tput" "cr"
check_result "_tput-cr-stdout" "$RET_OUT" $'\r' "stdout"
check_result "_tput-cr-stderr" "$RET_ERR" "" "stderr"

# --- _tput el ---
run_function "_tput" "el"
check_result "_tput-el-stdout" "$RET_OUT" $'\033[K' "stdout"
check_result "_tput-el-stderr" "$RET_ERR" "" "stderr"

# --- _tput bel with OO_MAIN_TESTS=1 must print nothing ---
run_function "_tput" "bel"
check_result "_tput-bel-stdout" "$RET_OUT" "" "stdout"
check_result "_tput-bel-stderr" "$RET_ERR" "" "stderr"

if [[ ${#errors[@]} -eq 0 ]]; then
	green_text "colorfunctions ($MODE): No errors"
	exit 0
else
	red_text "=> COLORFUNCTIONS-ERRORS =>\n"
	for i in "${errors[@]}"; do
		red_text "$i\n"
	done

	exit ${#errors[@]}
fi
}
