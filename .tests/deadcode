#!/usr/bin/env python3
"""Find unreachable and unused code."""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

THIS_DIR = Path(__file__).resolve().parent
if str(THIS_DIR) not in sys.path:
    sys.path.insert(0, str(THIS_DIR))

from _framework.helpers import red_text
from _framework.installer import ensure_dependencies


REPO_ROOT = THIS_DIR.parent


def main(argv=None) -> int:  # pylint: disable=unused-argument
    ensure_dependencies()
    os.environ.setdefault("install_tests", "1")

    current = subprocess.run(
        [sys.executable, "--version"], capture_output=True, text=True
    ).stdout.strip()
    if current == "Python 3.8.10":
        red_text(f"deadcode cannot be run with {current}")
        return 0

    # deadcode 2.4.1 still uses ast.Str, which was removed in Python 3.14.
    # Install a small compatibility shim before letting it walk the AST.
    compat_code = """
import ast

if not hasattr(ast, "Str"):
    class _StrMeta(type):
        def __instancecheck__(cls, instance):
            return isinstance(instance, ast.Constant) and isinstance(instance.value, str)

    class _Str(metaclass=_StrMeta):
        pass

    ast.Str = _Str

    if not hasattr(ast.Constant, "s"):
        ast.Constant.s = property(lambda self: self.value)

from deadcode.cli import main
main()
"""

    proc = subprocess.run(
        [sys.executable, "-c", compat_code, str(REPO_ROOT)],
        cwd=str(REPO_ROOT),
    )
    return proc.returncode


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
