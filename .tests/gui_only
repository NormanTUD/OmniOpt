#!/usr/bin/env python3
"""GUI-only test suite: runs only tests relevant to the .gui/ directory."""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
import time
from pathlib import Path

THIS_DIR = Path(__file__).resolve().parent
if str(THIS_DIR) not in sys.path:
    sys.path.insert(0, str(THIS_DIR))


REPO_ROOT = THIS_DIR.parent
TESTS = [
    "php_files", "php_unit_tests", "php_gui_localhost", "js_syntax", "js_gui_unit_tests",
    "php_search", "share", "share_tests", "share_uuid_routing",
    "find_typos_in_gui",
    "find_typos_in_js", "find_typos_in_php",
    "all_oo_options_are_in_gui_and_vice_versa", "find_double_function_names",
    "find_unused_share_functions", "doc_has_outdated_params",
    "find_missing_toc_in_md_files", "find_undocumented_exit_codes",
    "missing_plot_metadata",
]


def _interpreter_for(script: Path) -> str:
    """Pick the interpreter from the shebang, defaulting to Python.

    The GUI tests are Python scripts (some without a shebang). Running a
    failed Python test through bash as a fallback only hides the real
    traceback behind confusing shell errors, so we only fall back to
    bash for scripts that explicitly ask for a shell.
    """
    try:
        with script.open(encoding="utf-8", errors="replace") as fh:
            first_line = fh.readline().strip()
    except OSError:
        return "python3"
    if first_line.startswith("#!") and "python" not in first_line:
        if "bash" in first_line or first_line.endswith("/sh") or first_line.endswith(" sh"):
            return "bash"
    return "python3"


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description="Run GUI-only tests.")
    parser.add_argument("--run_with_coverage", action="store_true")
    args = parser.parse_args(argv)

    if args.run_with_coverage:
        from _framework import coverage_utils

        coverage_utils.enable_subprocess_coverage(repo_root=REPO_ROOT)

    runtimes: dict[str, int] = {}
    total_start = time.time()
    next_exit = 1
    for t in TESTS:
        start = time.time()
        print(f"Running {t} ...")
        script = THIS_DIR / t
        if not script.exists():
            print(f"FAIL {t} (missing)")
            return next_exit
        interpreter = _interpreter_for(script)
        proc = subprocess.run([interpreter, str(script)], cwd=str(REPO_ROOT))
        ok = proc.returncode == 0
        end = time.time()
        runtime = int(end - start)
        runtimes[t] = runtime
        if not ok:
            print(f"FAIL {t} ({runtime}s)")
            return next_exit
        next_exit += 1

    total_runtime = int(time.time() - total_start)
    print(f"\nGUI-only tests OK in {total_runtime}s\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
