#!/usr/bin/env python3
"""Main test orchestrator (replaces .tests/main bash script).

Usage:
    python3 .tests/main [options]

All options from the original bash script remain supported, plus an abstract
tag/filter system for combining test suites:

    --only=suite:basic,quick:false   run tests with ALL of these tags
    --exclude=suite:docker            skip tests with ANY of these tags
    --tags=suite:linter               run tests with at least ONE of these tags
"""

from __future__ import annotations

import os
import re
import sys
import time
from pathlib import Path

THIS_DIR = Path(__file__).resolve().parent
if str(THIS_DIR) not in sys.path:
    sys.path.insert(0, str(THIS_DIR))

# Make the autodeps framework venv importable before any other
# framework imports.  ``_framework.config`` requires ``yaml`` at import
# time, and we want the import order to work even when the system
# Python doesn't have ``yaml`` installed (e.g. inside the Docker
# container before any pip install has run).
import _framework.installer as _framework_installer
_bootstrap_venv = _framework_installer._resolve_venv_dir()
if _bootstrap_venv.exists():
    _framework_installer.add_venv_to_path(_bootstrap_venv)
else:
    # Fall back to creating the venv and installing requirements so the
    # imports below succeed.
    _framework_installer._create_venv(_bootstrap_venv)
    _framework_installer.add_venv_to_path(_bootstrap_venv)
    req_main = Path(__file__).resolve().parent.parent / "requirements.txt"
    req_test = Path(__file__).resolve().parent.parent / "test_requirements.txt"
    # Install through the Rich per-package progress bar (NOT raw ``_pip``),
    # so pip's own Collecting / `━━━` output is never shown while things are
    # healthy -- same nicer install UI as everywhere else.  ``_install_requirements_rich``
    # pre-installs Rich itself (guardrail A) so it works even on a fresh venv.
    if req_main.exists():
        if not _framework_installer._install_requirements_rich(
            _bootstrap_venv, req_main, "requirements"
        ):
            print("❌ Failed to install main requirements.", file=sys.stderr)
            sys.exit(20)
    if req_test.exists():
        if not _framework_installer._install_requirements_rich(
            _bootstrap_venv, req_test, "test requirements"
        ):
            print("❌ Failed to install test requirements.", file=sys.stderr)
            sys.exit(20)
    # Seed hashes so subsequent calls don't reinstall.
    import hashlib as _hashlib
    (_bootstrap_venv / "hash_main").write_text(
        _hashlib.md5(req_main.read_bytes()).hexdigest()
    )
    (_bootstrap_venv / "hash_test").write_text(
        _hashlib.md5(req_test.read_bytes()).hexdigest()
    )

from _framework import helpers
from _framework.installer import ensure_dependencies
from _framework.cli import (
    adjust_quick_flags,
    build_base_parser,
    collect_cli_overrides,
    cmd_omniopt_call,
    env_skip,
    num_gpus,
    parse_args,
    quick_skip,
    render_command,
)
from _framework.config import load_config
from _framework.runner import (
    get_state,
    print_table,
    print_table_markdown,
    reset_state,
    run_test_objects,
)


HELP_EPILOG = [
    "Examples:",
    "  python3 .tests/main                            # run everything",
    "  python3 .tests/main --quick                    # only quick tests",
    "  python3 .tests/main --no_plots --no_linter     # skip plot & linter tests",
    "  python3 .tests/main --only=suite:basic         # only the basic tests",
    "  python3 .tests/main --only=pyright             # only the pyright test",
    "  python3 .tests/main --class=moo,constraint     # only the given test classes",
    "  python3 .tests/main --exclude=suite:docker     # skip docker tests",
    "  python3 .tests/main --tags=suite:linter        # only linter tests",
    "  python3 .tests/main --list                     # list all matching tests",
]


def _select_tests(config, args):
    raw_only = [t.strip() for t in (args.only or "").split(",") if t.strip()]
    only_ids = [v for v in raw_only if ":" not in v] or None
    only_tags = [v for v in raw_only if ":" in v] or None
    only_classes = [c.strip() for c in (args.test_class or "").split(",") if c.strip()] or None
    exclude = [t.strip() for t in (args.exclude or "").split(",") if t.strip()] or None
    any_tag = [t.strip() for t in (args.tags or "").split(",") if t.strip()] or None

    unknown_ids = [i for i in (only_ids or []) if config.get_test(i) is None]
    if unknown_ids:
        helpers.red_text(f"Unknown test id(s): {', '.join(unknown_ids)}")
        helpers.red_text(f"Available ids: {', '.join(t.id for t in config.tests)}")
        sys.exit(1)
    unknown_classes = [c for c in (only_classes or []) if c not in config.classes()]
    if unknown_classes:
        helpers.red_text(f"Unknown test class(es): {', '.join(unknown_classes)}")
        helpers.red_text(f"Available classes: {', '.join(config.classes())}")
        sys.exit(1)

    selected = config.filter(
        only=only_tags,
        exclude=exclude,
        any_tag=any_tag,
        only_ids=only_ids,
        only_classes=only_classes,
    )

    if args.no_plots:
        selected = [t for t in selected if "suite:plot" not in t.tags]
    if args.no_linter:
        selected = [t for t in selected if "suite:linter" not in t.tags]
    if args.no_linkchecker:
        selected = [t for t in selected if "suite:link" not in t.tags]
    return selected


def _print_test_list(tests) -> None:
    if not tests:
        print("(no tests selected)")
        return
    longest_id = max(len(t.id) for t in tests)
    for t in tests:
        wanted = [t.wanted_exit_code]
        if t.alternative_exit_code is not None:
            wanted.append(t.alternative_exit_code)
        wanted_str = "/".join(str(c) for c in wanted)
        tags_str = ",".join(t.tags)
        class_str = t.test_class or "-"
        print(f"  {t.id.ljust(longest_id)}  class={class_str:<12}  tags=[{tags_str}]  wanted={wanted_str}")
    print(f"\n{len(tests)} test(s) selected.")


def _setup_coverage_env() -> None:
    """Honour --run_with_coverage: rewrite ``python3`` commands to run under
    coverage and measure every venv subprocess (incl. ``./omniopt`` re-execs)
    via ``COVERAGE_PROCESS_START`` + the repo's ``.coveragerc``."""
    os.environ["RUN_WITH_COVERAGE"] = "1"
    repo_root = Path(__file__).resolve().parent.parent
    coveragerc = repo_root / ".coveragerc"
    os.environ["COVERAGE_PROCESS_START"] = str(coveragerc)
    bin_dir = _bootstrap_venv / "bin"
    if bin_dir.is_dir() and str(bin_dir) not in os.environ.get("PATH", "").split(os.pathsep):
        os.environ["PATH"] = str(bin_dir) + os.pathsep + os.environ.get("PATH", "")


def _render_command_with_coverage(cmd: str) -> str:
    """Replace ``python3 <script>`` invocations with ``coverage run -p <script>``
    so the test scripts themselves are measured too."""
    return re.sub(r"\bpython3(?=\s)", "coverage run -p", cmd)


def main(argv=None) -> int:
    os.environ.setdefault("ENABLE_BEARTYPE", "1")
    os.environ.setdefault("install_tests", "1")
    os.environ.setdefault("OO_MAIN_TESTS", "1")
    os.environ.setdefault("DONT_SHOW_DONT_INSTALL_MESSAGE", "1")
    os.environ.setdefault("DISABLE_SIXEL_GRAPHICS", "1")

    helpers.ensure_install_tests_env()
    ensure_dependencies(include_tests=True)
    config = load_config()

    parser = build_base_parser(
        config,
        description="Main test orchestrator for OmniOpt.",
    )
    args = parse_args(parser, argv if argv is not None else sys.argv[1:])
    args = adjust_quick_flags(args)

    if args.run_with_coverage:
        _setup_coverage_env()

    # Environment-specific toggles.
    in_container = helpers.in_container()
    is_ci = helpers.is_ci()
    has_nvidia = helpers.command_exists("nvidia-smi")
    has_sbatch = helpers.command_exists("sbatch")
    has_docker = helpers.command_exists("docker")

    NUM_GPUS = num_gpus(args, has_nvidia)
    if not args.NUM_GPUS:
        args.NUM_GPUS = str(NUM_GPUS)
    if not has_sbatch and not args.max_eval:
        args.max_eval = "2"
        args.num_parallel_jobs = "1"
        args.num_random_steps = "1"
    if not has_sbatch and not args.num_parallel_jobs:
        args.num_parallel_jobs = "1"

    if (is_ci or in_container or not has_docker) and any(
        "env:docker" in t.tags for t in config.tests
    ):
        helpers.yellow_text(
            "Skipping docker-tagged tests: "
            f"{'in CI' if is_ci else ''}"
            f"{'/in container' if in_container else ''}"
            f"{'/no docker binary' if not has_docker else ''}".lstrip("/")
            + "."
        )

    selected = _select_tests(config, args)

    if args.list_only:
        _print_test_list(selected)
        return 0

    if not selected:
        print("No tests selected.")
        return 0

    print(f"Python-Version:")
    import subprocess
    print(subprocess.check_output([sys.executable, "--version"], text=True).strip())
    print(f"Number of tests selected: {len(selected)}")

    reset_state()
    state = get_state()
    state.exit_on_first_error = bool(args.exit_on_first_error)
    state.skip_first_n = int(args.skip_first_n_tests or 0)

    parallel = getattr(args, "parallel", None)
    if parallel is None:
        parallel = os.environ.get("OMNIOPT_TESTS_PARALLEL")

    start = time.time()

    def render(test):
        cmd = render_command(test.cmd or "", config, args)
        if os.environ.get("RUN_WITH_COVERAGE"):
            cmd = _render_command_with_coverage(cmd)
        return cmd

    try:
        run_test_objects(
            selected,
            quick_pred=lambda t: quick_skip(t, args),
            env_pred=lambda t, a=args, ic=in_container, ci=is_ci,
                       hn=has_nvidia, hs=has_sbatch, hd=has_docker: env_skip(
                t, a, in_container=ic, is_ci=ci, has_nvidia=hn,
                has_sbatch=hs, has_docker=hd,
            ),
            render_command=render,
            dry_run=bool(args.dry_run),
            parallel=parallel,
        )
    except KeyboardInterrupt:
        state.interrupted = True
        helpers.red_text("\nInterrupted by Ctrl+C. Stopping test run.")

    elapsed = int(time.time() - start)
    print(f"\nTest took {helpers.displaytime(elapsed)}")

    print_table()
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        with open(summary, "a", encoding="utf-8") as f:
            f.write(print_table_markdown() + "\n")

    if state.interrupted:
        helpers.red_text("\nTest run interrupted by Ctrl+C.")
        return 130

    return len(state.errors)


if __name__ == "__main__":
    for line in HELP_EPILOG:
        print(line)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
