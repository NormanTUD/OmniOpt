#!/usr/bin/env python3
"""storage_error - randomly reports a Read/Write failure or a RESULT."""

import random
import sys


def main() -> int:
    if random.randint(0, 1) == 0:
        print("Read/Write failure")
    else:
        print(f"RESULT: {random.randint(0, 2**31 - 1)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
