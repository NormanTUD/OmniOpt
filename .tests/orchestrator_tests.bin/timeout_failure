#!/usr/bin/env python3
"""timeout_failure - randomly reports a timeout failure or a RESULT."""

import random
import sys


def main() -> int:
    if random.randint(0, 1) == 0:
        print("Timeout failure")
    else:
        print(f"RESULT: {random.randint(0, 2**31 - 1)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
