def _free_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind(("127.0.0.1", 0))
        return int(sock.getsockname()[1])


def _server_output() -> str:
    if _SERVER_LOG is None:
        return ""
    try:
        _SERVER_LOG.flush()
        return Path(_SERVER_LOG.name).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def _start_server(shares: Path) -> tuple[subprocess.Popen, object, str]:
    port = _free_port()
    env = os.environ.copy()
    env["OO_TARGET_FILE"] = str(GUI_DIR / "share_internal.php")
    env["share_path"] = str(shares)
    env["CI"] = "1"
    env.pop("disable_folder_creation", None)

    log_path = Path(tempfile.mkstemp(prefix="oo_share_uuid_server_", suffix=".log")[1])
    log = log_path.open("w", encoding="utf-8")
    proc = subprocess.Popen(
        [
            "php",
            "-S",
            f"127.0.0.1:{port}",
            "-t",
            str(GUI_DIR),
            str(THIS_DIR / "share_test_router.php"),
        ],
        cwd=str(GUI_DIR),
        env=env,
        stdout=log,
        stderr=subprocess.STDOUT,
        text=True,
    )

    deadline = time.time() + 20
    while time.time() < deadline:
        if proc.poll() is not None:
            log.flush()
            output = log_path.read_text(encoding="utf-8", errors="replace")
            log.close()
            log_path.unlink(missing_ok=True)
            raise RuntimeError("PHP server exited during startup:\n" + output)
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.25):
                return proc, log, f"http://127.0.0.1:{port}"
        except OSError:
            time.sleep(0.05)

    proc.terminate()
    output = log_path.read_text(encoding="utf-8", errors="replace")
    log.close()
    log_path.unlink(missing_ok=True)
    raise RuntimeError("PHP server did not start in time:\n" + output)


def _stop_server(proc, log) -> None:
    if proc is not None and proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=5)
    if log is not None:
        name = getattr(log, "name", "")
        log.close()
        if name:
            Path(name).unlink(missing_ok=True)


