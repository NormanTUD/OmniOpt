def check(name: str, condition: bool, detail: str = "") -> bool:
    if condition:
        return True
    msg = f"{name}" + (f": {detail}" if detail else "")
    _ERRORS.append(msg)
    red_text(f"FAIL: {msg}")
    return False


def check_eq(name: str, expected, got) -> bool:
    return check(name, expected == got, f"expected {expected!r}, got {got!r}")


_TESTS: list = []


def test(fn):
    _TESTS.append(fn)
    return fn


