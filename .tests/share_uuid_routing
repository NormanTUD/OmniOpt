@test
def uuid_of_existing_job_in_other_user_does_not_update_it() -> bool:
    owner, exp = identity("cross_user_owner")
    setup_old_job(owner, exp, uuid="uuid-owner", content="OWNER\n")

    intruder_user = owner + "_intruder"
    run = make_local_run("intruder", uuid="uuid-owner", content="INTRUDER\n")
    upload_ok(run, user=intruder_user, experiment=exp, update=True, manifest_uuid="uuid-owner")

    ok = check_eq("owner share untouched", "OWNER\n", read_share_file(owner, exp, "0", "results.csv"))
    ok &= check_eq("intruder got a separate folder", ["0"], run_folders(intruder_user, exp))
    ok &= check_eq("intruder content separate", "INTRUDER\n", read_share_file(intruder_user, exp, "0", "results.csv"))
    return ok


