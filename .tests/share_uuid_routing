    setup_old_job(user, exp, uuid="uuid-old", content="OLD\n", password="secret")

    new_run = make_local_run("new", uuid="uuid-new", content="NEW\n")
    upload_ok(new_run, user=user, experiment=exp, update=True, manifest_uuid="uuid-new")

    ok = check_eq("new job created despite old password", ["0", "1"], run_folders(user, exp))
    ok &= check("new job has no inherited password", not (folder_path(user, exp, "1") / "password.sha256").exists())
    return ok


@test
def updating_password_protected_job_requires_the_password() -> bool:
    user, exp = identity("protected_update")
    setup_old_job(user, exp, uuid="uuid-protected", content="OLD\n", password="secret")

    updated = make_local_run("updated", uuid="uuid-protected", content="NEW\n")
    status, body, _ = upload(
        updated,
        user=user,
        experiment=exp,
        update=True,
        manifest_uuid="uuid-protected",
        password=None,
    )
    ok = check(
        "update without password is rejected",
        status == 200 and "password" in body.lower(),
        f"status={status}, body={body[:200]!r}",
    )
    ok &= check_eq("rejected update did not modify the share", "OLD\n", read_share_file(user, exp, "0", "results.csv"))

    upload_ok(
        updated,
        user=user,
        experiment=exp,
        update=True,
        manifest_uuid="uuid-protected",
        password="secret",
    )
    ok &= check_eq("update with password succeeds", "NEW\n", read_share_file(user, exp, "0", "results.csv"))
    return ok


