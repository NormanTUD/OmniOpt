def make_local_run(
    label: str,
    *,
    uuid=_ABSENT,
    content: str | None = None,
    extra_files: dict[str, str] | None = None,
) -> Path:
    root = _TMP / "local" / label / "experiment" / "0"
    root.mkdir(parents=True, exist_ok=True)
    text = content if content is not None else f"content of {label}\n"
    (root / "results.csv").write_text(text, encoding="utf-8")
    (root / "parameters.txt").write_text("x: range(1, 2)\n", encoding="utf-8")
    (root / "git_version").write_text("deadbeef\n", encoding="utf-8")
    if uuid is not _ABSENT and uuid is not None:
        state = root / "state_files"
        state.mkdir(exist_ok=True)
        (state / "run_uuid").write_text(str(uuid), encoding="utf-8")
    for rel, value in (extra_files or {}).items():
        path = root / rel
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(value, encoding="utf-8")
    return root


def _post_with_query(
    manifest: dict,
    zip_path: Path,
    *,
    extra_query: str = "",
) -> tuple[int, str]:
    params = {
        "user_id": manifest["user_id"],
        "experiment_name": manifest["experiment_name"],
    }
    if manifest["update"]:
        params["update"] = "1"
    if manifest["update_uuid"]:
        params["update_uuid"] = str(manifest["update_uuid"])
    if manifest["password"]:
        params["password"] = str(manifest["password"])
    url = f"{_BASE_URL}/share_internal.php?" + urllib.parse.urlencode(params)
    if extra_query:
        url += "&" + extra_query

    boundary = "----oo-share-uuid-test-" + os.urandom(8).hex()
    length, chunks = os_._build_multipart_stream(boundary, manifest, zip_path)
    body = b"".join(chunks)
    if len(body) != length:
        raise AssertionError("multipart content-length mismatch")

    req = urllib.request.Request(
        url,
        data=body,
        headers={
            "Content-Type": f"multipart/form-data; boundary={boundary}",
            "Content-Length": str(length),
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status, resp.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as exc:  # pragma: no cover - for parity
        return exc.code, exc.read().decode("utf-8", errors="replace")


def upload(
    run_dir: Path,
    *,
    user: str,
    experiment: str,
    update: bool,
    manifest_uuid=_ABSENT,
    password: str | None = None,
    extra_query: str = "",
) -> tuple[int, str, dict]:
    files = os_.collect_shareable_files(
        str(run_dir), send_single_runs=False, include_state_files=False
    )
    manifest = os_.build_manifest(
        run_dir=str(run_dir),
        user_id=user,
        experiment_name=experiment,
        update=bool(update),
        update_uuid=None,
        password=password,
        send_single_runs=False,
        include_state_files=False,
        files=files,
    )
    if manifest_uuid is not _ABSENT:
        manifest["update_uuid"] = manifest_uuid

    out_dir = Path(tempfile.mkdtemp(prefix="oo_share_uuid_bundle_"))
    try:
        _, zip_path = os_.write_bundle(manifest, out_dir, source_dir=run_dir)
        status, body = _post_with_query(
            manifest, zip_path, extra_query=extra_query
        )
    finally:
        shutil.rmtree(out_dir, ignore_errors=True)
    return status, body, manifest


def upload_ok(*args, **kwargs) -> tuple[str, dict]:
    status, body, manifest = upload(*args, **kwargs)
    ok = check(
        f"upload succeeded ({kwargs.get('user')}/{kwargs.get('experiment')})",
        status == 200 and "Error" not in body,
        f"status={status}, body={body[:300]!r}",
    )
    if not ok:
        raise AssertionError(body)
    return body, manifest


def _shares_base(user: str, experiment: str) -> Path:
    return _SHARES / user / experiment


def run_folders(user: str, experiment: str) -> list[str]:
    base = _shares_base(user, experiment)
    if not base.is_dir():
        return []
    return sorted(
        [p.name for p in base.iterdir() if p.is_dir() and p.name.isdigit()],
        key=int,
    )


def folder_path(user: str, experiment: str, run_nr: str) -> Path:
    return _shares_base(user, experiment) / run_nr


def read_share_file(user: str, experiment: str, run_nr: str, rel: str) -> str:
    path = folder_path(user, experiment, run_nr) / rel
    return path.read_text(encoding="utf-8")


def identity(name: str) -> tuple[str, str]:
    safe = "".join(ch if ch.isalnum() else "_" for ch in name)[:40]
    return f"user_{safe}", f"exp_{safe}"


def setup_old_job(
    user: str,
    experiment: str,
    *,
    uuid: str = "old-uuid",
    content: str = "OLD\n",
    label: str = "old",
    password: str | None = None,
) -> Path:
    run = make_local_run(label, uuid=uuid, content=content)
    upload_ok(
        run,
        user=user,
        experiment=experiment,
        update=False,
        manifest_uuid=uuid,
        password=password,
    )
    return run


