@test
def three_new_uuids_create_three_separate_jobs() -> bool:
    user, exp = identity("three_new_uuids")
    for idx, uuid in enumerate(("uuid-a", "uuid-b", "uuid-c")):
        run = make_local_run(f"job{idx}", uuid=uuid, content=f"CONTENT-{idx}\n")
        upload_ok(run, user=user, experiment=exp, update=True, manifest_uuid=uuid)

    ok = check_eq("three folders exist", ["0", "1", "2"], run_folders(user, exp))
    for idx, uuid in enumerate(("uuid-a", "uuid-b", "uuid-c")):
        ok &= check_eq(
            f"run {idx} has UUID {uuid}",
            uuid,
            read_share_file(user, exp, str(idx), "state_files/run_uuid"),
        )
        ok &= check_eq(
            f"run {idx} has its own content",
            f"CONTENT-{idx}\n",
            read_share_file(user, exp, str(idx), "results.csv"),
        )
    return ok


