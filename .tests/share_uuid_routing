@test
def new_uuid_with_existing_old_job_creates_new_folder() -> bool:
    user, exp = identity("new_uuid_existing_old")
    setup_old_job(user, exp, uuid="uuid-old", content="OLD\n")

    new_run = make_local_run("new", uuid="uuid-new", content="NEW\n")
    upload_ok(
        new_run,
        user=user,
        experiment=exp,
        update=True,
        manifest_uuid="uuid-new",
    )

    ok = check_eq("old job remains in run 0 and new job gets run 1", ["0", "1"], run_folders(user, exp))
    ok &= check_eq("run 0 still has the old UUID", "uuid-old", read_share_file(user, exp, "0", "state_files/run_uuid"))
    ok &= check_eq("run 1 has the new UUID", "uuid-new", read_share_file(user, exp, "1", "state_files/run_uuid"))
    ok &= check_eq("run 0 keeps the old results", "OLD\n", read_share_file(user, exp, "0", "results.csv"))
    ok &= check_eq("run 1 has the new results", "NEW\n", read_share_file(user, exp, "1", "results.csv"))
    return ok


@test
def new_uuid_does_not_copy_old_files_into_new_folder() -> bool:
    user, exp = identity("new_uuid_no_file_mix")
    setup_old_job(user, exp, uuid="uuid-old", content="OLD\n")
    (folder_path(user, exp, "0") / "old_only.txt").write_text("only-old\n", encoding="utf-8")

    new_run = make_local_run(
        "new",
        uuid="uuid-new",
        content="NEW\n",
        extra_files={"new_only.txt": "only-new\n"},
    )
    upload_ok(new_run, user=user, experiment=exp, update=True, manifest_uuid="uuid-new")

    new_folder = folder_path(user, exp, "1")
    old_folder = folder_path(user, exp, "0")
    ok = check("new folder does not contain old-only files", not (new_folder / "old_only.txt").exists())
    ok &= check("old folder does not contain new-only files", not (old_folder / "new_only.txt").exists())
    ok &= check_eq("old-only file is still in old folder", "only-old\n", read_share_file(user, exp, "0", "old_only.txt"))
    ok &= check_eq("new-only file is in new folder", "only-new\n", read_share_file(user, exp, "1", "new_only.txt"))
    return ok


