def _php_unit_tests() -> bool:
    if not shutil.which("php"):
        yellow_text("PHP not installed, skipping share UUID routing tests")
        return True
    proc = subprocess.run(
        ["php", str(GUI_DIR / "test_share_uuid_routing.php")],
        cwd=str(GUI_DIR),
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        red_text("PHP UUID routing unit tests failed:")
        red_text((proc.stdout or "") + (proc.stderr or ""))
        return False
    return True


def main(argv=None) -> int:  # pylint: disable=unused-argument
    global _BASE_URL, _SHARES, _TMP, _SERVER, _SERVER_LOG

    if not shutil.which("php"):
        yellow_text("PHP not installed, skipping share UUID routing tests")
        return 0

    if not _php_unit_tests():
        return 1

    work = Path(tempfile.mkdtemp(prefix="oo_share_uuid_routing_"))
    _TMP = work
    _SHARES = work / "shares"
    _SHARES.mkdir(parents=True)
    try:
        _SERVER, _SERVER_LOG, _BASE_URL = _start_server(_SHARES)
        passed = 0
        for fn in _TESTS:
            name = getattr(fn, "__name__", str(fn))
            before = len(_ERRORS)
            try:
                fn()
            except Exception as exc:  # pylint: disable=broad-except
                _ERRORS.append(f"{name}: exception {exc!r}")
                red_text(f"FAIL: {name}: exception {exc!r}")
            if len(_ERRORS) == before:
                passed += 1
            else:
                log = _server_output()
                if log.strip():
                    red_text(f"--- PHP server log (tail) ---\n{log[-1500:]}")
        total = len(_TESTS)
        if _ERRORS:
            red_text(f"share UUID routing: {total - passed}/{total} test(s) failed")
            for err in _ERRORS:
                red_text(f"  - {err}")
            return min(255, len(_ERRORS))

        green_text(f"share UUID routing: all {total} test(s) passed")
        return 0
    finally:
        _stop_server(_SERVER, _SERVER_LOG)
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
