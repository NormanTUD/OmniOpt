def test_real_paper_style_complex() -> bool:
    # A typical complex formula from an ML paper.
    # L = -1/N * Σ_i [y_i * log(σ(w*x_i + b)) + (1-y_i) * log(1-σ(w*x_i + b))]
    # Use infix since LaTeX \sigma still trips over too many edge cases.
    text = (
        "L = -1/N * Sum(y_i * log(sigma(w*x_i + b))"
        " + (1 - y_i) * log(1 - sigma(w*x_i + b)), (i, 1, N))"
    )
    expr = formulas.parse_latex_or_infix(text, mode="infix")
    free = sorted(s.name for s in expr.free_symbols)
    params, consts, bound = formulas.suggest_formula_split(text, expr)
    p_names = sorted(p.name for p in params)
    b_names = sorted(bound)
    return _check(
        # ``i`` is bound, ``y_i`` / ``x_i`` are single symbols that appear
        # in the body of the sum.
        "i" in b_names and "N" in free,
        f"paper-style: free={free}, params={p_names}, bound={b_names}",
    )


