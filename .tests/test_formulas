def test_tutorial_parameter_inference_table() -> bool:
    ok = True
    cases = [
        # (text, mode, expected_params, expected_consts)
        ("f(x, y) = x^2 + y^2",   "infix", ["x", "y"], []),
        ("f(x) = a*x + b",         "infix", ["x"],      ["a", "b"]),
        # ``f(x) = \sum_{i=0}^{n} i*x``: only x is in the LHS, so n is a
        # constant by default (the user can flip it to a range in the GUI
        # or pass `--parameter n range …` on the CLI).
        ("f(x) = \\sum_{i=0}^{n} i*x", "latex", ["x"], ["n"]),
        # No LHS → every free symbol is a parameter.
        ("a + sin(b)",             "infix", ["a", "b"], []),
    ]
    for text, mode, expected_params, expected_consts in cases:
        expr = formulas.parse_latex_or_infix(text, mode=mode)
        params, consts, _ = formulas.suggest_formula_split(text, expr)
        p_names = sorted(p.name for p in params)
        c_names = sorted(c.name for c in consts)
        if p_names != sorted(expected_params):
            ok = _check(False, f"{text!r}: params should be {sorted(expected_params)}, got {p_names}")
        if c_names != sorted(expected_consts):
            ok = _check(False, f"{text!r}: consts should be {sorted(expected_consts)}, got {c_names}")
    return ok


