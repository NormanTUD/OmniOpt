def test_outer_parens_extend_sum_body() -> bool:
    """(\\sum_{i=0}^{n} i^2 + 1)  →  both i^2 AND 1 are inside the sum."""
    processed = formulas.preprocess_latex(r"(\sum_{i=0}^{n} i^2 + 1)")
    return _check(
