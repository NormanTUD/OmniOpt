#!/usr/bin/env python3
"""Unit tests for ``.formulas.py``.

Covers:

* LaTeX / infix parsing (with and without antlr4)
* Hyperparameter suggestion (auto-detection of free symbols)
* LaTeX-with-underbraces rendering
* ASCII rendering
* ``lambdify`` building and execution

Each test is a ``def test_*() -> bool`` function returning ``True`` on
success.  The module exits non-zero if any test fails.
"""

from __future__ import annotations

import math
import re
import sys
import tempfile
from importlib.machinery import SourceFileLoader
from pathlib import Path

THIS_DIR = Path(__file__).resolve().parent
REPO_ROOT = THIS_DIR.parent

if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from _framework.helpers import red_text  # noqa: E402


def _load(name: str, location: Path):
    return SourceFileLoader(name, str(location)).load_module()


formulas = _load("formulas", REPO_ROOT / ".formulas.py")


def _check(condition: bool, message: str) -> bool:
    if not condition:
        red_text(f"FAIL: {message}")
        return False
    return True


def _approx_eq(a: float, b: float, tol: float = 1e-9) -> bool:
    return abs(a - b) < tol


