    text = r"L = L_{\mathrm{data}} + \lambda * \|w\|^{2}"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    free = sorted(s.name for s in expr.free_symbols)
    # ``\lambda`` (a Python keyword) is renamed to ``lam_`` by the
    # macro substitution table.
    return _check(
        free == ["L_data", "lam_", "w"],
        f"reg loss free should be [L_data, lam_, w]; got {free}",
    )


def test_real_double_sum() -> bool:
    # Double sum: Σ_i Σ_j a_i * b_j
