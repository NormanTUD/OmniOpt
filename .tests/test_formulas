def test_tutorial_sphere() -> bool:
    # Tutorial § "Sphere (quick start)": f(x, y) = x**2 + y**2
    text = "f(x, y) = x**2 + y**2"
    expr = formulas.parse_latex_or_infix(text, mode="infix")
    fn = formulas.build_lambda(expr, ["x", "y"])
    free = sorted(s.name for s in expr.free_symbols)
    ok = True
    if free != ["x", "y"]:
        ok = _check(False, f"sphere: free should be [x,y], got {free}")
    if not _approx_eq(fn(x=3.0, y=4.0), 25.0):
        ok = _check(False, f"sphere(3,4) should be 25, got {fn(x=3.0, y=4.0)}")
    return ok


def test_tutorial_quadratic_loss() -> bool:
    # Tutorial § "Quadratic loss": f(x) = a*x**2 + b*x + c
    text = "f(x) = a*x**2 + b*x + c"
    expr = formulas.parse_latex_or_infix(text, mode="infix")
    # x is the parameter; a, b, c are RHS-only (constants in the GUI's
    # terminology).  Verify the GUI-side split matches.
    params, consts, _ = formulas.suggest_formula_split(text, expr)
    p_names = sorted(p.name for p in params)
    c_names = sorted(c.name for c in consts)
    ok = True
    if p_names != ["x"]:
        ok = _check(False, f"quadratic: params should be [x], got {p_names}")
    if c_names != ["a", "b", "c"]:
        ok = _check(False, f"quadratic: consts should be [a,b,c], got {c_names}")
    # And numerically: with a=1, b=2, c=3, f(2)=4+4+3=11
    from sympy import Float
    e2 = expr.subs([("a", Float(1.0)), ("b", Float(2.0)), ("c", Float(3.0))])
    fn = formulas.build_lambda(e2, ["x"])
    if not _approx_eq(fn(x=2.0), 11.0):
        ok = _check(False, f"quadratic(2) with a=1,b=2,c=3 should be 11, got {fn(x=2.0)}")
    return ok


def test_tutorial_sigmoid() -> bool:
    # Tutorial § "Sigmoid": \sigma(z) = \frac{1}{1 + e^{-z}}
    text = r"\sigma(z) = \frac{1}{1 + e^{-z}}"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    # The bare `e` in `e**(-z)` becomes a sympy Symbol; substitute
    # Euler's number before evaluating.
    from sympy import Symbol
    expr2 = expr.subs(Symbol("e"), math.e)
    fn = formulas.build_lambda(expr2, ["z"])
    ok = True
    if not _approx_eq(fn(z=0.0), 0.5):
        ok = _check(False, f"sigmoid(0) should be 0.5, got {fn(z=0.0)}")
    if fn(z=10.0) < 0.99:
        ok = _check(False, f"sigmoid(10) should be ~1, got {fn(z=10.0)}")
    return ok


def test_tutorial_polynomial_kernel() -> bool:
    # Tutorial § "Polynomial kernel": K(x, y) = (x \cdot y + c)^{d}
    text = r"K(x, y) = (x \cdot y + c)^{d}"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    # x, y are LHS parameters; c, d are RHS-only constants.
    params, consts, _ = formulas.suggest_formula_split(text, expr)
    p_names = sorted(p.name for p in params)
    c_names = sorted(c.name for c in consts)
    ok = True
    if p_names != ["x", "y"]:
        ok = _check(False, f"poly kernel: params should be [x,y], got {p_names}")
    if c_names != ["c", "d"]:
        ok = _check(False, f"poly kernel: consts should be [c,d], got {c_names}")
    # With c=1, d=2: (2*3 + 1)^2 = 49.
    from sympy import Float
    e2 = expr.subs([("c", Float(1.0)), ("d", Float(2.0))])
    fn = formulas.build_lambda(e2, ["x", "y"])
    if not _approx_eq(fn(x=2.0, y=3.0), 49.0):
        ok = _check(False, f"poly kernel(2,3) with c=1,d=2 should be 49, got {fn(x=2.0, y=3.0)}")
    return ok


def test_tutorial_sigmoid_cross_entropy() -> bool:
    # Tutorial § "Sigmoid cross-entropy":
    # L = -1/n * Sum(y_i * log(sigmoid(w*x_i + b))
    #              + (1 - y_i) * log(1 - sigmoid(w*x_i + b)),
    #          (i, 0, n))
    text = ("L = -1/n * Sum(y_i * log(sigmoid(w*x_i + b)) + "
            "(1 - y_i) * log(1 - sigmoid(w*x_i + b)), "
            "(i, 0, n))")
    # ``sigmoid`` is not a sympy builtin — rewrite ``sigmoid(arg)`` to
    # ``1/(1+exp(arg))`` so the expression parses cleanly.  The regex
    # handles the open-and-close parens around the single argument.
    text_py = re.sub(r"sigmoid\(([^()]*)\)", r"1/(1+exp(\1))", text)
    expr = formulas.parse_latex_or_infix(text_py, mode="infix")
    bound = formulas._find_bound_names(text)
    free = sorted(s.name for s in expr.free_symbols)
    ok = True
    if "i" not in bound:
        ok = _check(False, f"cross-entropy: bound should include 'i', got {bound}")
    if not all(name in free for name in ("w", "b", "n", "y_i", "x_i")):
        ok = _check(False, f"cross-entropy: free should include w,b,n,y_i,x_i, got {free}")
    return ok


def test_tutorial_definite_integral() -> bool:
    # Tutorial § "Definite integral": \int_{0}^{1} x**2 \,dx
    # No free symbols → the lambda is constant.
    text = r"\int_{0}^{1} x**2 \,dx"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    fn = formulas.build_lambda(expr, [])
    ok = True
    if expr.free_symbols:
        ok = _check(False, f"definite integral should have no free symbols, got {sorted(s.name for s in expr.free_symbols)}")
    if not _approx_eq(fn(), 1.0 / 3.0):
        ok = _check(False, f"∫0..1 x² dx should be 1/3, got {fn()}")
    return ok


def test_tutorial_definite_integral_with_param() -> bool:
    # The tutorial's "make at least one bound a hyperparameter" example:
    # \int_{0}^{n} x^2 \,dx   — n is free.
    text = r"\int_{0}^{n} x^2 \,dx"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    fn = formulas.build_lambda(expr, ["n"])
    free = sorted(s.name for s in expr.free_symbols)
    ok = True
    if free != ["n"]:
        ok = _check(False, f"variable-bound integral: free should be [n], got {free}")
    # ∫0..n x² dx = n³/3
    if not _approx_eq(fn(n=3.0), 9.0):
        ok = _check(False, f"∫0..3 x² dx should be 9, got {fn(n=3.0)}")
    if not _approx_eq(fn(n=2.0), 8.0 / 3.0):
        ok = _check(False, f"∫0..2 x² dx should be 8/3, got {fn(n=2.0)}")
    return ok


def test_tutorial_bare_infix() -> bool:
    # Tutorial § "Bare infix": sin(x)**2 + cos(x)**2  (must be 1 for all x)
    text = "sin(x)**2 + cos(x)**2"
    expr = formulas.parse_latex_or_infix(text, mode="infix")
    fn = formulas.build_lambda(expr, ["x"])
    ok = True
    for val in (0.0, 0.5, 1.0, 2.5, 6.0):
        if not _approx_eq(fn(x=val), 1.0):
            ok = _check(False, f"sin²+cos² at x={val} should be 1, got {fn(x=val)}")
            break
    return ok


def test_tutorial_multi_objective() -> bool:
    # Tutorial § "Multi-objective": f(x) = (x**2, (x - 3)**2)
    text = "f(x) = (x**2, (x - 3)**2)"
    expr = formulas.parse_latex_or_infix(text, mode="infix")
    fn = formulas.build_lambda(expr, ["x"])
    result = fn(x=0.0)
    ok = True
    if not (isinstance(result, tuple) and len(result) == 2):
        return _check(False, f"multi-obj formula should return tuple of 2, got {result!r}")
    if not (_approx_eq(result[0], 0.0) and _approx_eq(result[1], 9.0)):
        ok = _check(False, f"multi-obj at x=0 should be (0, 9), got {result}")
    result = fn(x=3.0)
    if not (_approx_eq(result[0], 9.0) and _approx_eq(result[1], 0.0)):
        ok = _check(False, f"multi-obj at x=3 should be (9, 0), got {result}")
    return ok


