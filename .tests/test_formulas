def test_user_formula_integral_evaluates() -> bool:
    """f(x,y,a,z) = \\int_{q=a}^z 2x + b  evaluates correctly."""
    text = r"f(x, y, a, z) = \int_{q = a}^z 2x + b"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    fn = formulas.build_lambda(expr, ["a", "b", "x", "z"])
    # integral of 2x from q=a to q=z = 2x*(z-a); plus b
    val = fn(a=1.0, b=10.0, x=3.0, z=4.0)
    expected = 2.0 * 3.0 * (4.0 - 1.0) + 10.0  # 18 + 10 = 28
    return _check(
        _approx_eq(val, expected),
        f"integral eval: expected {expected}, got {val}",
    )


