def test_real_mse_regression() -> bool:
    # Mean squared error: MSE = (1/n) * Σ(y_i - ŷ_i)²
    text = r"\mathrm{MSE}(n) = \frac{1}{n} \sum_{i=1}^{n} (y_i - \hat{y}_i)**2"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    free = sorted(s.name for s in expr.free_symbols)
    # ``\hat{y}_i`` collapses to ``y_i`` after macro stripping, so the
    # difference cancels to 0.  ``i`` is bound by the sum; ``n`` is
    # the only free symbol left after LHS stripping.
    return _check(
        free == ["n"],
        f"MSE free should be [n]; got {free}",
    )


def test_real_cross_entropy() -> bool:
    # Cross-entropy loss: H = -Σ p * log(q)
    text = r"\mathrm{H}(p, q) = -\sum_{i} p_i \log(q_i)"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    free = sorted(s.name for s in expr.free_symbols)
    # ``p_i`` and ``q_i`` are single sympy symbols (subscripts aren't
    # split); ``H`` is stripped from the LHS, ``i`` is bound.
    return _check(
        free == ["p_i", "q_i"],
        f"cross-entropy free should be [p_i, q_i]; got {free}",
    )


def test_real_quadratic_loss() -> bool:
    # Quadratic loss: L(a, b, c) = a*x² + b*x + c
    text = "f(x) = a*x**2 + b*x + c"
    expr = formulas.parse_latex_or_infix(text, mode="infix")
    # Substitute values for the constants to evaluate
    from sympy import Float
    e2 = expr.subs([("a", Float(1.0)), ("b", Float(2.0)), ("c", Float(3.0))])
    fn = formulas.build_lambda(e2, ["x"])
    val = fn(x=2.0)
    expected = 1.0 * 4 + 2.0 * 2 + 3.0
    return _check(
        _approx_eq(val, expected),
        f"quadratic f(2)=1*4+2*2+3={expected}, got {val}",
    )


def test_real_sigmoid() -> bool:
    # Sigmoid: σ(z) = 1 / (1 + e^(-z))
    text = r"\sigma(z) = \frac{1}{1 + e^{-z}}"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    # The bare ``e`` in ``e**(-z)`` becomes a sympy Symbol; substitute
    # it with Euler's number before evaluating.
    from sympy import Symbol
    expr2 = expr.subs(Symbol("e"), math.e)
    fn = formulas.build_lambda(expr2, ["z"])
    # σ(0) = 0.5
    v0 = fn(z=0.0)
    # σ(10) ≈ 1
    v10 = fn(z=10.0)
    return _check(
        _approx_eq(v0, 0.5) and v10 > 0.99,
        f"sigmoid: σ(0)={v0}, σ(10)={v10}",
    )


def test_real_polynomial_kernel() -> bool:
    # Polynomial kernel: K(x, y) = (x*y + c)^d
    text = r"K(x, y) = (x \cdot y + c)^{d}"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    fn = formulas.build_lambda(expr, ["x", "y"])
    # With c=1, d=2: (2*3 + 1)^2 = 49
    from sympy import Float
    e2 = expr.subs([("c", Float(1.0)), ("d", Float(2.0))])
    fn2 = formulas.build_lambda(e2, ["x", "y"])
    v = fn2(x=2.0, y=3.0)
    return _check(
        _approx_eq(v, 49.0),
        f"poly kernel (2,3) with c=1,d=2 should be 49, got {v}",
    )


def test_real_q_learning() -> bool:
    # Q-learning: Q(s, a) = r + γ * max_a Q(s', a)
    # In infix, this is q = r + gamma * q_next
    text = "q = r + gamma * q_next"
    expr = formulas.parse_latex_or_infix(text, mode="infix")
    params, consts, _ = formulas.suggest_formula_split(text, expr)
    p_names = sorted(p.name for p in params)
    c_names = sorted(c.name for c in consts)
    # q is in LHS → parameter (the "y" we're computing).
    # r, gamma, q_next are RHS-only → constants.
    return _check(
        p_names == ["q"] and c_names == ["gamma", "q_next", "r"],
        f"q-learning: params={p_names}, consts={c_names}",
    )


def test_real_hyperbolic() -> bool:
    # Hyperbolic sine: sinh(x) = (e^x - e^(-x)) / 2
    text = r"\sinh(x) = \frac{e^{x} - e^{-x}}{2}"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    # The bare ``e`` becomes a sympy Symbol; substitute Euler's number.
    from sympy import Symbol
    expr2 = expr.subs(Symbol("e"), math.e)
    fn = formulas.build_lambda(expr2, ["x"])
    # sinh(1) ≈ 1.1752
    val = fn(x=1.0)
    return _check(
        _approx_eq(val, (math.e - 1.0 / math.e) / 2),
        f"sinh(1) should be {(math.e - 1.0 / math.e) / 2}, got {val}",
    )


def test_real_entropy() -> bool:
    # Information entropy: H = -Σ p*log(p)
    text = r"H = -\sum_{i} p_i \cdot \log(p_i)"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    # H is on the LHS and gets stripped; ``p_i`` is a single sympy
    # symbol (subscripts aren't split), and ``i`` is bound by the sum.
    free = sorted(s.name for s in expr.free_symbols)
    return _check(
        free == ["p_i"],
        f"entropy free should be [p_i]; got {free}",
    )


def test_real_regularized_loss() -> bool:
