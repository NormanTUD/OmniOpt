# Infix parsing
# ---------------------------------------------------------------------------

def test_parse_infix_simple() -> bool:
    expr = formulas.parse_infix("x**2 + sin(a)*b")
    free = sorted(s.name for s in expr.free_symbols)
    return _check(free == ["a", "b", "x"], f"free symbols should be [a,b,x], got {free}")


def test_parse_infix_summation() -> bool:
    expr = formulas.parse_infix("Sum(i**2, (i, 0, n))")
    free = sorted(s.name for s in expr.free_symbols)
    return _check(free == ["n"], f"free symbols should be [n], got {free}")


