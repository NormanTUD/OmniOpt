def test_render_ascii_nonempty() -> bool:
    expr = formulas.parse_infix("x**2 + 2*x + 1")
    ascii_str = formulas.render_ascii(expr)
    return _check(len(ascii_str) > 0 and "x" in ascii_str, f"ascii output should contain 'x', got: {ascii_str!r}")


def test_render_latex_underbraces() -> bool:
    expr = formulas.parse_infix("a*x + b")
    rendered = formulas.render_latex_with_underbraces(expr, ["a", "b"])
    # We expect \underbrace{a} ... \underbrace{b}
    return _check(
        r"\underbrace{a}" in rendered and r"\underbrace{b}" in rendered,
        f"underbraces for a and b should appear, got: {rendered!r}",
    )


