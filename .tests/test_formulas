        f"echo-corrupted formula should still parse to free=[x,y], got {free}",
    )


def test_regression_echo_corruption_full_eval() -> bool:
    """Corrupted formula still evaluates correctly end-to-end."""
    import base64
    # The exact base64 that $(echo 'f(x, y) = \\int_{q=x}^y \\frac{x}{y}' | base64 -w0) produces
    corrupted_b64 = "Zih4LCB5KSA9IFxpbnRfe3E9eH1eeSAMcmFje3h9e3l9Cg=="
    corrupted = base64.b64decode(corrupted_b64).decode("utf-8", errors="replace")
    expr = formulas.parse_latex_or_infix(corrupted, mode="auto")
    fn = formulas.build_lambda(expr, ["x", "y"])
    val = fn(x=2.0, y=4.0)
    expected = (2.0 / 4.0) * (4.0 - 2.0)  # x/y * (y-x) = 1.0
    return _check(
        _approx_eq(val, expected),
        f"echo-corrupted eval: expected {expected}, got {val}",
    )


