    cases = [
        (r"\alpha", "alpha"),
        (r"\beta",  "beta"),
        (r"\gamma", "gamma"),
        (r"\sigma", "sigma"),
        (r"\omega", "omega"),
        (r"\pi",    "pi"),     # constant — handled specially
        (r"\infty", "oo"),     # constant — handled specially
    ]
    ok = True
    for text, _expected_name in cases:
        try:
            expr = formulas.parse_latex_or_infix(text, mode="latex")
        except Exception as exc:
            ok = _check(False, f"{text!r}: should parse, got {exc!r}")
    return ok


