def test_real_continued_job_picks_up_formula() -> bool:
    # After a job has been run with --formula, continuing it should
    # re-read the formula files (formula.txt etc.) and produce the
    # same suggestions.  We simulate this by parsing a stored formula
    # from the run folder and verifying the parsed expression matches
    # what we'd get from re-parsing the original text.
    text = "f(x, y) = x**2 + 2*x*y + y**2"
    # First parse to populate state
    expr = formulas.parse_latex_or_infix(text, mode="infix")
    # Round-trip via LaTeX
    latex = formulas.render_latex(expr)
    # Re-parse the LaTeX — should give an equivalent expression.
    expr2 = formulas.parse_latex_or_infix(latex, mode="latex")
    # The free symbols should be the same.
    free1 = sorted(s.name for s in expr.free_symbols)
    free2 = sorted(s.name for s in expr2.free_symbols)
    return _check(
        free1 == free2 and free1 == ["x", "y"],
        f"round-trip free should match: {free1} vs {free2}",
    )


def test_real_python_run_program_with_extra() -> bool:
    # Default-case: user writes a Python script as their run-program
    # (no formula).  Verify formula extraction returns nothing.
    text = """#!/usr/bin/env python3
import sys, json
d = json.loads(sys.argv[1])
result = d['lr'] * d['epochs'] + d['batch_size']
print('RESULT:', result)
"""
    # Should extract lr, epochs, batch_size.
    import re
    seen = {}
    out = []
    for m in re.finditer(
        r"""d(?:\s*\.\s*get\s*\()?\s*\[?\s*['"]([A-Za-z_][A-Za-z0-9_]*)['"]\s*\)?""",
        text,
    ):
        n = m.group(1)
        if not seen.get(n):
            seen[n] = True
            out.append(n)
    return _check(
        sorted(out) == ["batch_size", "epochs", "lr"],
        f"py defaults: should extract [batch_size, epochs, lr], got {out}",
    )


