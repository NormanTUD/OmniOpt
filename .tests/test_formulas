def test_lambdify_with_constants() -> bool:
    # When the formula has known constants like pi, the call-back should
    # be callable with only the parameters (pi is substituted internally).
    expr = formulas.parse_infix("pi*x + 2")
    fn = formulas.build_lambda(expr, ["x"])
    val = fn(x=1.0)
    expected = math.pi + 2.0
    return _check(
        _approx_eq(val, expected),
        f"pi*x + 2 with x=1 should be {expected}, got {val}",
    )


def test_multi_result_handling() -> bool:
    # The Python-mode formula can return a tuple.  Verify the formula
    # helper's multi-result output format is preserved when the call-back
    # is invoked with numpy semantics.
    from sympy import Tuple, symbols
    a, b = symbols("a b")
    expr = Tuple(a, b)
    fn = formulas.build_lambda(expr, ["a", "b"])
    out = fn(a=1.0, b=2.0)
    return _check(
        isinstance(out, tuple) and len(out) == 2 and _approx_eq(out[0], 1.0) and _approx_eq(out[1], 2.0),
        f"tuple formula should return (a, b); got {out!r}",
    )


