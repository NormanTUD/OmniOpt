def test_tutorial_infix_code_block() -> bool:
    ok = True

    # sin(x) + cos(y)                    # trig
    expr = formulas.parse_infix("sin(x) + cos(y)")
    fn = formulas.build_lambda(expr, ["x", "y"])
    if not _approx_eq(fn(x=0.0, y=0.0), 1.0):
        ok = _check(False, f"sin+cos at (0,0) should be 1, got {fn(x=0.0, y=0.0)}")

    # exp(-x**2) / sqrt(2*pi)            # gaussian
    expr = formulas.parse_infix("exp(-x**2) / sqrt(2*pi)")
    fn = formulas.build_lambda(expr, ["x"])
    if not _approx_eq(fn(x=0.0), 1.0 / math.sqrt(2.0 * math.pi)):
        ok = _check(False, f"gaussian(0) should be 1/sqrt(2π), got {fn(x=0.0)}")

    # Sum(i**2, (i, 0, n))               # sum with bound variable
    expr = formulas.parse_infix("Sum(i**2, (i, 0, n))")
    fn = formulas.build_lambda(expr, ["n"])
    # sympy lambdifies the Sum as ``sum(i**2 for i in range(0, n+1))``
    # which needs an int upper bound, so pass ints explicitly.  Σ 0..n
    # i² = n(n+1)(2n+1)/6.
    for n in (2, 3, 5):
        expected = n * (n + 1) * (2 * n + 1) / 6
        if not _approx_eq(fn(n=int(n)), expected):
            ok = _check(False, f"sum-of-squares(n={n}) should be {expected}, got {fn(n=int(n))}")
            break

    # Product((x - i), (i, 1, k))        # product
    # ``Product`` is not auto-evaluated by ``build_lambda`` (only definite
    # ``Integral`` is); verify that it parses and that the expression
    # is the right sympy object instead of evaluating numerically.
    expr = formulas.parse_infix("Product((x - i), (i, 1, k))")
    from sympy import Product as _Product, Symbol
    expected = _Product(Symbol("x") - Symbol("i"), (Symbol("i"), 1, Symbol("k")))
    if expr != expected:
        ok = _check(False, f"product should parse to {expected}, got {expr}")

    # Integral(exp(-x**2), (x, -oo, oo)) # integral (closed form: sqrt(pi))
    expr = formulas.parse_infix("Integral(exp(-x**2), (x, -oo, oo))")
    fn = formulas.build_lambda(expr, [])
    if not _approx_eq(fn(), math.sqrt(math.pi)):
        ok = _check(False, f"∫exp(-x²) dx should be sqrt(pi), got {fn()}")

    # Derivative(f, x)                   # derivative
    # Sympy's lambdify cannot compile an unevaluated ``Derivative``
    # node, so verify the parse rather than calling the lambda.  The
    # derivative of ``sin(x)`` at ``x=0`` would evaluate to ``1`` if
    # sympy could simplify it, but ``build_lambda`` leaves the
    # Derivative unevaluated.
    from sympy import Derivative as _Derivative, Symbol as _Symbol, sin as _sin
    expr = formulas.parse_infix("Derivative(sin(x), x)")
    expected = _Derivative(_sin(_Symbol("x")), _Symbol("x"))
    if expr != expected:
        ok = _check(False, f"Derivative(sin(x), x) should parse to {expected}, got {expr}")

    # Limit(sin(x)/x, x, 0)              # limit
    # ``Limit`` (like ``Derivative``) cannot be compiled by sympy's
    # NumPy printer; verify it parses to the right sympy object.
    from sympy import Limit as _Limit, Symbol as _Symbol, sin as _sin
    expr = formulas.parse_infix("Limit(sin(x)/x, x, 0)")
    expected = _Limit(_sin(_Symbol("x")) / _Symbol("x"), _Symbol("x"), 0)
    if expr != expected:
        ok = _check(False, f"Limit(sin(x)/x, x, 0) should parse to {expected}, got {expr}")

    # Min(a, b)  Max(a, b)               # min / max
    expr = formulas.parse_infix("Min(a, b)")
    fn = formulas.build_lambda(expr, ["a", "b"])
    if not (_approx_eq(fn(a=2.0, b=5.0), 2.0) and _approx_eq(fn(a=5.0, b=2.0), 2.0)):
        ok = _check(False, f"Min(2,5) should be 2, got {fn(a=2.0, b=5.0)}")
    expr = formulas.parse_infix("Max(a, b)")
    fn = formulas.build_lambda(expr, ["a", "b"])
    if not (_approx_eq(fn(a=2.0, b=5.0), 5.0) and _approx_eq(fn(a=5.0, b=2.0), 5.0)):
        ok = _check(False, f"Max(2,5) should be 5, got {fn(a=2.0, b=5.0)}")

    # abs(x - y)                         # absolute value
    expr = formulas.parse_infix("abs(x - y)")
    fn = formulas.build_lambda(expr, ["x", "y"])
    if not (_approx_eq(fn(x=5.0, y=3.0), 2.0) and _approx_eq(fn(x=3.0, y=5.0), 2.0)):
        ok = _check(False, f"abs(x-y) should be |5-3|=2, got {fn(x=5.0, y=3.0)}")

    # sign(x)  floor(x)  ceil(x)         # rounding
    expr = formulas.parse_infix("sign(x)")
    fn = formulas.build_lambda(expr, ["x"])
    if not (_approx_eq(fn(x=-2.5), -1.0) and _approx_eq(fn(x=0.0), 0.0) and _approx_eq(fn(x=3.5), 1.0)):
        ok = _check(False, f"sign(-2.5/0/3.5) should be -1/0/1, got {fn(x=-2.5)}, {fn(x=0.0)}, {fn(x=3.5)}")
    expr = formulas.parse_infix("floor(x)")
    fn = formulas.build_lambda(expr, ["x"])
    if not _approx_eq(fn(x=2.7), 2.0):
        ok = _check(False, f"floor(2.7) should be 2, got {fn(x=2.7)}")
    expr = formulas.parse_infix("ceil(x)")
    fn = formulas.build_lambda(expr, ["x"])
    if not _approx_eq(fn(x=2.3), 3.0):
        ok = _check(False, f"ceil(2.3) should be 3, got {fn(x=2.3)}")

    # 2**x  x**2  x**y                   # powers
    for text, args, expected in [
        ("2**x",  {"x": 3.0}, 8.0),
        ("x**2",  {"x": 5.0}, 25.0),
        ("x**y",  {"x": 2.0, "y": 3.0}, 8.0),
    ]:
        expr = formulas.parse_infix(text)
        fn = formulas.build_lambda(expr, list(args.keys()))
        if not _approx_eq(fn(**args), expected):
            ok = _check(False, f"{text} with {args} should be {expected}, got {fn(**args)}")

    return ok


def test_tutorial_implicit_multiplication() -> bool:
    # "Implicit multiplication is on by default: 2x, xy, (a)(b) all work."
    ok = True
    for text, args, expected in [
        ("2*x",  {"x": 3.0}, 6.0),       # explicit
