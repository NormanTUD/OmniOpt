def test_regression_frac_not_split_into_letters() -> bool:
    """\\frac{x}{y} must parse as x/y, NOT as a*c*r*x*y."""
    processed = formulas.preprocess_latex(r"\frac{x}{y}")
    return _check(
        processed == "(x)/(y)",
        f"\\frac{{x}}{{y}} should be (x)/(y), got {processed!r}",
    )


def test_regression_frac_inside_integral() -> bool:
    """\\int_{q=x}^y \\frac{x}{y} must parse as Integral(x/y, (q, x, y))."""
    text = r"f(x, y) = \int_{q=x}^y \frac{x}{y}"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    free = sorted(s.name for s in expr.free_symbols)
    # Only x and y should be free (q is bound by the integral).
    return _check(
        free == ["x", "y"],
        f"frac-in-integral free should be [x,y], got {free}",
    )


def test_regression_frac_inside_integral_evaluates() -> bool:
    """\\int_{q=x}^y x/y dq = x/y * (y-x) = x - x^2/y."""
    text = r"f(x, y) = \int_{q=x}^y \frac{x}{y}"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    fn = formulas.build_lambda(expr, ["x", "y"])
    val = fn(x=2.0, y=4.0)
    # x/y * (y-x) = 0.5 * 2 = 1.0
    expected = (2.0 / 4.0) * (4.0 - 2.0)
    return _check(
        _approx_eq(val, expected),
        f"frac-in-integral eval: expected {expected}, got {val}",
    )


def test_regression_backslash_f_not_formfeed() -> bool:
    """Ensure \\frac survives the full preprocess without becoming form-feed."""
    text = r"\frac{x}{y}"
    processed = formulas.preprocess_latex(text)
    return _check(
        "\x0c" not in processed and "frac" not in processed,
        f"no form-feed or literal 'frac' in output, got {processed!r}",
    )


def test_regression_echo_corruption_formfeed_repaired() -> bool:
    """Formulas corrupted by shell echo (\\f -> form feed) are auto-repaired."""
    # Simulate: echo '...\\frac{x}{y}' produces \x0crac{x}{y}
    corrupted = "f(x, y) = \\int_{q=x}^y \x0crac{x}{y}"
    expr = formulas.parse_latex_or_infix(corrupted, mode="auto")
    free = sorted(s.name for s in expr.free_symbols)
    return _check(
