def test_parse_latex_sum() -> bool:
    expr = formulas.parse_latex_or_infix(r"\sum_{i=0}^{n} i**2", mode="latex")
    free = sorted(s.name for s in expr.free_symbols)
    return _check(free == ["n"], f"sum free symbols should be [n], got {free}")


def test_parse_infix_strips_lhs() -> bool:
    # f(x) = ... assignments should be tolerated.
    for text in ("f(x) = 2+x-y", "y=2+x-y", "f=2+x-y"):
        expr = formulas.parse_latex_or_infix(text, mode="infix")
        free = sorted(s.name for s in expr.free_symbols)
        ok = _check(free == ["x", "y"], f"{text!r} free should be [x,y], got {free}")
        if not ok:
            return False
    return True


def test_suggest_constants_as_fixed() -> bool:
    expr = formulas.parse_infix("sin(e*a) + b + pi")
    suggestions = formulas.suggest_hyperparameters(expr)
    by_name = {s.name: s for s in suggestions}
    ok = True
    if "e" not in by_name:
        ok = _check(False, "e should be in suggestions")
    elif by_name["e"].kind != "fixed":
        ok = _check(False, f"e should be fixed, got {by_name['e'].kind}")
    elif abs(by_name["e"].lower - 2.718281828459045) > 1e-12:
        ok = _check(False, f"e value wrong: {by_name['e'].lower}")
    if not ok:
        return False
    if "a" not in by_name or by_name["a"].kind != "range":
        return _check(False, "a should be a range parameter")
    return _check("b" in by_name, "b should be in suggestions")


def test_split_lhs_parameters_only() -> bool:
    # f(x) = 2 + x - y  → x is a parameter, y is a constant.
    text = "f(x) = 2 + x - y"
    expr = formulas.parse_latex_or_infix(text, mode="infix")
    params, consts, bound = formulas.suggest_formula_split(text, expr)
    p_names = sorted(p.name for p in params)
    c_names = sorted(c.name for c in consts)
    return _check(
        p_names == ["x"] and c_names == ["y"],
        f"LHS-split: params should be [x], consts [y]; got params={p_names}, consts={c_names}",
    )


def test_split_lhs_multi_param() -> bool:
    # f(x, y) = x*x + y*y  → both are parameters.
    text = "f(x, y) = x*x + y*y"
    expr = formulas.parse_latex_or_infix(text, mode="infix")
    params, consts, _ = formulas.suggest_formula_split(text, expr)
    p_names = sorted(p.name for p in params)
    c_names = sorted(c.name for c in consts)
    return _check(
        p_names == ["x", "y"] and c_names == [],
        f"multi-param: params should be [x,y]; got params={p_names}, consts={c_names}",
    )


def test_split_no_lhs_all_params() -> bool:
