def test_lambdify_simple() -> bool:
    expr = formulas.parse_infix("a*x**2 + b*x + c")
    fn = formulas.build_lambda(expr, ["a", "b", "c", "x"])
    val = fn(a=1, b=2, c=3, x=4)
    expected = 1 * 16 + 2 * 4 + 3
    return _check(_approx_eq(val, expected), f"fn(1,2,3,4) should be {expected}, got {val}")


def test_lambdify_trig() -> bool:
    expr = formulas.parse_infix("sin(a) + cos(b)")
    fn = formulas.build_lambda(expr, ["a", "b"])
    val = fn(a=0, b=0)
    return _check(_approx_eq(val, 1.0), f"sin(0)+cos(0) should be 1, got {val}")


def test_lambda_for_extra() -> bool:
    f = formulas.Formula.parse("a*x + sin(x)", mode="infix")
    fn = f.lambda_for(["a", "x"])
    val = fn(a=1, x=math.pi / 2)
    # a*x + sin(x) = 1*pi/2 + sin(pi/2) = pi/2 + 1
    expected = math.pi / 2 + 1
    return _check(_approx_eq(val, expected), f"fn(1, pi/2) should be {expected}, got {val}")


