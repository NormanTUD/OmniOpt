def test_tutorial_table_sums_integrals_limits() -> bool:
    # \sum_{i=0}^{n} f, \sum_{i} f, \prod, \int, \lim, \frac{d}{dx}
    cases = [
        (r"\sum_{i=0}^{n} i**2",     "latex", ["n"]),       # i bound
        (r"\sum_{i} i**2",           "latex", []),           # i bound, n default → still no free
        (r"\prod_{i=1}^{k} i",       "latex", ["k"]),
        (r"\int_{a}^{b} x \,dx",     "latex", ["a", "b"]),
        (r"\int x \,dx",             "latex", []),           # unbounded → no free
        (r"\lim_{x \to v} 1/x",      "latex", ["v"]),
    ]
    ok = True
    for text, mode, expected in cases:
        expr = formulas.parse_latex_or_infix(text, mode=mode)
        free = sorted(s.name for s in expr.free_symbols)
        if free != sorted(expected):
            ok = _check(False, f"{text!r}: free should be {sorted(expected)}, got {free}")
    # ``\frac{d}{dx} x**2`` produces ``Derivative(x**2, x)`` which sympy
    # keeps ``x`` as a free symbol (it cannot lambdify the derivative
    # directly).  We only verify that the parser recognises the pattern
    # and produces the right Derivative expression.
    from sympy import Derivative, Symbol
    expr = formulas.parse_latex_or_infix(r"\frac{d}{dx} x**2", mode="latex")
    if expr != Derivative(Symbol("x") ** 2, Symbol("x")):
        ok = _check(False, f"\\frac{{d}}{{dx}} x**2 should be Derivative(x**2, x), got {expr}")
    return ok


