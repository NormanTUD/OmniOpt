def test_split_sum_bound_excluded() -> bool:
    # f(x) = Sum(i, (i, 0, n)) + b  → x is a parameter; i is bound (excluded).
    # n is RHS-only, so it becomes a constant by default (user can change to
    # range if they want to optimise the upper limit).  b is RHS-only too.
    text = "f(x) = Sum(i, (i, 0, n)) + b"
    expr = formulas.parse_latex_or_infix(text, mode="infix")
    params, consts, bound = formulas.suggest_formula_split(text, expr)
    p_names = sorted(p.name for p in params)
    c_names = sorted(c.name for c in consts)
    b_names = sorted(bound)
    return _check(
        p_names == ["x"] and c_names == ["b", "n"] and b_names == ["i"] and "i" not in c_names and "i" not in p_names,
        f"sum: params=[x], consts=[b,n], bound=[i]; got params={p_names}, consts={c_names}, bound={b_names}",
    )


