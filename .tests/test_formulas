def test_real_world_formula_with_integral() -> bool:
    # f(x) = a + sin(b) + x * \\int_{x = 5}^5 q
    # The integral is degenerate (bounds equal) so the whole formula
    # collapses to ``a + sin(b)``; ``x`` and ``q`` are still free
    # symbols though, since ``x`` appears in both the LHS and the
    # integral (integral binding takes precedence).
    text = r"f(x) = a + \sin(b) + x * \int_{x = 5}^5 q"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    free = sorted(s.name for s in expr.free_symbols)
    return _check(
        free == ["a", "b", "q", "x"],
        f"free symbols should be [a, b, q, x], got {free}",
    )


def test_real_world_formula_with_integral_evaluates() -> bool:
    # Same formula but evaluate it as a numeric lambda.
    text = r"f(x) = a + \sin(b) + x * \int_{x = 5}^5 q"
    expr = formulas.parse_latex_or_infix(text, mode="latex")
    fn = formulas.build_lambda(expr, ["a", "b", "q", "x"])
    val = fn(a=1.0, b=3.0, q=4.0, x=2.0)
    expected = 1.0 + math.sin(3.0)  # integral evaluates to 0, so x * 0 = 0
    return _check(
        _approx_eq(val, expected),
        f"expected {expected}, got {val}",
    )


def test_integral_not_treated_as_variable_in_lhs() -> bool:
    # When ``f(x) = ...`` meets ``\\int_{x=...} ...``, the integral's
    # binding variable shadows the LHS parameter.  Verify the bound
    # detection picks up the integral variable even though ``x``
    # already appears in the LHS.
    text = r"f(x) = a + \int_{x=5}^{10} q"
    bound = formulas._find_bound_names(text)
    return _check(
        "x" in bound,
        f"x should be in bound names (integral wins over LHS), got {bound}",
    )


