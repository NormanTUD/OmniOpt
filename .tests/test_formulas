    text = "f(x) = 2*x + y\n"
    expr = formulas.parse_latex_or_infix(text.strip(), mode="infix")
    free = sorted(s.name for s in expr.free_symbols)
    return _check(free == ["x", "y"], f"stripped text free should be [x,y], got {free}")


