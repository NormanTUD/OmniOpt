def test_tutorial_naming_hints() -> bool:
    ok = True
    # `*_int` → int [0, 10]
    expr = formulas.parse_infix("epochs_int * lr_learning_rate")
    suggestions = {s.name: s for s in formulas.suggest_hyperparameters(expr)}
    if "epochs_int" not in suggestions:
        ok = _check(False, "epochs_int should be a suggested parameter")
    elif suggestions["epochs_int"].value_type != "int":
        ok = _check(False, f"epochs_int: value_type should be int, got {suggestions['epochs_int'].value_type}")
    elif suggestions["epochs_int"].kind != "range":
        ok = _check(False, f"epochs_int: kind should be range, got {suggestions['epochs_int'].kind}")
    elif (suggestions["epochs_int"].lower, suggestions["epochs_int"].upper) != (0.0, 10.0):
        ok = _check(False, f"epochs_int: range should be (0, 10), got ({suggestions['epochs_int'].lower}, {suggestions['epochs_int'].upper})")

    # `lr_*` → float, log_scale=true, [1e-5, 1e-1]
    if "lr_learning_rate" not in suggestions:
        ok = _check(False, "lr_learning_rate should be a suggested parameter")
    elif suggestions["lr_learning_rate"].value_type != "float":
        ok = _check(False, f"lr_learning_rate: value_type should be float, got {suggestions['lr_learning_rate'].value_type}")
    elif not suggestions["lr_learning_rate"].log_scale:
        ok = _check(False, f"lr_learning_rate: log_scale should be True, got {suggestions['lr_learning_rate'].log_scale}")
    elif (suggestions["lr_learning_rate"].lower, suggestions["lr_learning_rate"].upper) != (1e-5, 1e-1):
        ok = _check(False, f"lr_learning_rate: range should be (1e-5, 1e-1), got ({suggestions['lr_learning_rate'].lower}, {suggestions['lr_learning_rate'].upper})")

    # anything else → float, [-1, 1], no log scale
    expr = formulas.parse_infix("a + b")
    suggestions = {s.name: s for s in formulas.suggest_hyperparameters(expr)}
    for name in ("a", "b"):
        if suggestions.get(name) is None:
            ok = _check(False, f"{name} should be suggested")
            continue
        s = suggestions[name]
        if s.value_type != "float":
            ok = _check(False, f"{name}: value_type should be float, got {s.value_type}")
        elif s.log_scale:
            ok = _check(False, f"{name}: log_scale should be False")
        elif (s.lower, s.upper) != (-1.0, 1.0):
            ok = _check(False, f"{name}: range should be (-1, 1), got ({s.lower}, {s.upper})")
    return ok


