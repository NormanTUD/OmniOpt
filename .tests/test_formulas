def test_suggest_basic() -> bool:
    expr = formulas.parse_infix("a*alpha**2 + b*alpha + c")
    suggestions = formulas.suggest_hyperparameters(expr)
    names = sorted(s.name for s in suggestions)
    return _check(names == ["a", "alpha", "b", "c"], f"suggested names should include alpha, got {names}")


def test_suggest_excludes_builtins() -> bool:
    # Pre-declare symbols so sympy doesn't split them via implicit multiplication.
    from sympy import Symbol, sin, log, pi
    a, b = Symbol("a"), Symbol("b")
    expr = sin(pi * a) + log(b)
    suggestions = formulas.suggest_hyperparameters(expr)
    names = sorted(s.name for s in suggestions)
    # pi is builtin; a and b should remain
    return _check("a" in names and "b" in names and "pi" not in names,
                  f"a and b should remain; got {names}")


def test_suggest_log_scale_heuristic() -> bool:
    # Use lr_alpha as the variable name so sympy doesn't split it into l*r*alpha
    expr = formulas.parse_infix("lr_alpha * epochs")
    suggestions = formulas.suggest_hyperparameters(expr)
    lr = next((s for s in suggestions if s.name == "lr_alpha"), None)
    return _check(lr is not None and lr.log_scale,
                  "name 'lr_alpha' should trigger log_scale suggestion")


def test_suggest_skips_reserved() -> bool:
    expr = formulas.parse_infix("pi*x + pi")
