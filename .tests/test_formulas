def test_python_extract_params() -> bool:
    # Python-mode formula: parse params['x'] / params["y"] / params.get('z').
    text = """def evaluate(params):
    a = params['x'] + params['y']
    return a * params.get('z')
"""
    # Replicate the regex used in the GUI so we exercise the same logic.
    import re
    seen = {}
    out = []
    for m in re.finditer(
        r"""params(?:\s*\.\s*get\s*\()?\s*\[?\s*['"]([A-Za-z_][A-Za-z0-9_]*)['"]\s*\)?""",
        text,
    ):
        n = m.group(1)
        if not seen.get(n):
            seen[n] = True
            out.append(n)
    return _check(out == ["x", "y", "z"], f"py params regex should pick [x,y,z], got {out}")


def test_formula_text_with_continuation() -> bool:
    # The user's earlier failing case: formula passed through a shell with
    # ``$(echo '...' | base64 -w0)`` may have a trailing newline.  The
