def main() -> int:
    failures = 0
    for t in TESTS:
        print(f"running {t.__name__} ...", end=" ", flush=True)
        try:
            ok = t()
        except Exception as exc:
            ok = False
            red_text(f"\n  EXCEPTION: {exc!r}")
        if ok:
            print("ok")
        else:
            failures += 1
            print("FAIL")
    if failures:
        red_text(f"\n{failures} test(s) failed")
        return 1
    print("\nAll formula tests passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
