def test_marker_locations_order_and_dedup() -> bool:
    locations = liveshare.marker_locations(
        "/a/b/exp/0", cwd="/a/b", script_dir="/a/b"
    )
    got = [(loc.scope, loc.folder) for loc in locations]
    expected = [
        ("run", "/a/b/exp/0"),
        ("experiment", "/a/b/exp"),
        ("global", "/a/b"),
    ]
    return _eq(got, expected, "deduplicated marker locations")


def test_marker_locations_two_global_roots() -> bool:
    locations = liveshare.marker_locations(
        "/a/b/exp/0", cwd="/work", script_dir="/opt/omniopt"
    )
    got = [(loc.scope, loc.folder) for loc in locations]
    expected = [
        ("run", "/a/b/exp/0"),
        ("experiment", "/a/b/exp"),
        ("global", "/work"),
        ("global", "/opt/omniopt"),
    ]
    return _eq(got, expected, "cwd before script-dir")


def test_marker_locations_without_run_folder() -> bool:
    locations = liveshare.marker_locations(None, cwd="/work", script_dir="/opt/omniopt")
    got = [(loc.scope, loc.folder) for loc in locations]
    return _eq(got, [("global", "/work"), ("global", "/opt/omniopt")], "global only")


def test_marker_locations_are_absolute() -> bool:
    locations = liveshare.marker_locations("relative/exp/0", cwd=".", script_dir="..")
    return _check(
        all(Path(loc.folder).is_absolute() for loc in locations),
        "all marker locations must be absolute",
    )


