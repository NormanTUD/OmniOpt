# ---------------------------------------------------------------------------
# State machine
# ---------------------------------------------------------------------------


def test_state_activation_only_once() -> bool:
    with _tree() as tree:
        state = liveshare.State()
        _touch(tree["cwd"] / liveshare.START_MARKER)

        first = state.apply(_decide(tree))
        second = state.apply(_decide(tree))
        return (
            _eq(first, liveshare.MarkerAction.START, "first poll activates")
            and _check(second is None, "second poll must be a no-op")
            and _check(state.active, "state must be active")
        )


def test_deleting_start_marker_does_not_stop() -> bool:
    with _tree() as tree:
        state = liveshare.State()
        marker = _touch(tree["cwd"] / liveshare.START_MARKER)
        state.apply(_decide(tree))

        _remove(marker)
        action = state.apply(_decide(tree))
        return (
            _check(action is None, "deleting liveshare must not stop sharing")
            and _check(state.active, "state must stay active")
        )


def test_stop_marker_stops_once() -> bool:
    with _tree() as tree:
        state = liveshare.State(active=True)
        stop_marker = _touch(tree["run"] / liveshare.STOP_MARKER)

        first = state.apply(_decide(tree))
        second = state.apply(_decide(tree))
        return (
            _eq(first, liveshare.MarkerAction.STOP, "stop marker deactivates")
            and _check(second is None, "stop must only be announced once")
            and _check(not state.active, "state must be inactive")
            and _eq(_decide(tree).path, str(stop_marker), "stop path")
        )


def test_deleting_stop_marker_does_not_restart() -> bool:
    with _tree() as tree:
        state = liveshare.State(active=True)
        stop_marker = _touch(tree["cwd"] / liveshare.STOP_MARKER)
        state.apply(_decide(tree))

        _remove(stop_marker)
        action = state.apply(_decide(tree))
        return (
            _check(action is None, "deleting stop_liveshare must not restart")
            and _check(not state.active, "state must stay inactive")
        )


def test_full_lifecycle() -> bool:
    with _tree() as tree:
        state = liveshare.State()
        global_start = _touch(tree["cwd"] / liveshare.START_MARKER)
        run_stop = tree["run"] / liveshare.STOP_MARKER

        steps: List[Tuple[object, object]] = []
        steps.append((state.apply(_decide(tree)), liveshare.MarkerAction.START))
        steps.append((state.apply(_decide(tree)), None))

        _remove(global_start)
        steps.append((state.apply(_decide(tree)), None))

        _touch(run_stop)
        steps.append((state.apply(_decide(tree)), liveshare.MarkerAction.STOP))
        steps.append((state.apply(_decide(tree)), None))

        _remove(run_stop)
        steps.append((state.apply(_decide(tree)), None))

        _touch(tree["run"] / liveshare.START_MARKER)
        steps.append((state.apply(_decide(tree)), liveshare.MarkerAction.START))

        return all(_eq(actual, expected, "lifecycle step") for actual, expected in steps)


def test_initial_active_from_cli_flag() -> bool:
    with _tree() as tree:
        state = liveshare.State(active=True)

        _touch(tree["cwd"] / liveshare.START_MARKER)
        no_op = state.apply(_decide(tree))

        _touch(tree["run"] / liveshare.STOP_MARKER)
        stop = state.apply(_decide(tree))

        return (
            _check(no_op is None, "an already running CLI share is not re-announced")
            and _eq(stop, liveshare.MarkerAction.STOP, "stop marker may stop CLI share")
            and _check(not state.active, "CLI share must be off")
        )


