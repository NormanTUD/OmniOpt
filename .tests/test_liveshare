def test_decide_none() -> bool:
    with _tree() as tree:
        return _check(_decide(tree) is None, "no marker must yield no decision")


def test_decide_global_from_cwd() -> bool:
    with _tree() as tree:
        marker = _touch(tree["cwd"] / liveshare.START_MARKER)
        decision = _decide(tree)
        return (
            _check(decision is not None, "cwd marker must be found")
            and _eq(decision.action, liveshare.MarkerAction.START, "action")
            and _eq(decision.scope, "global", "scope")
            and _eq(decision.path, str(marker), "path")
        )


