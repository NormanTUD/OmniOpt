#!/usr/bin/env python3
"""Tests for the file-based live-share marker control (`.liveshare.py`).

The tests cover:

  * marker discovery and scope ordering (run / experiment / global),
  * ``stop_liveshare`` precedence,
  * the state machine that guarantees a single activation announcement,
  * share-URL extraction from ``omniopt_share`` output,
  * tqdm-aware announcement rendering (including fallbacks).
"""

from __future__ import annotations

import contextlib
import io
import sys
import tempfile
from importlib.machinery import SourceFileLoader
from pathlib import Path
from typing import List, Tuple

THIS_DIR = Path(__file__).resolve().parent
REPO_ROOT = THIS_DIR.parent

if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from _framework.helpers import red_text  # noqa: E402

# pylint: disable-next=deprecated-method
liveshare = SourceFileLoader(
    "liveshare_under_test", str(REPO_ROOT / ".liveshare.py")
).load_module()


def _check(condition: bool, message: str) -> bool:
    if not condition:
        red_text(f"FAIL: {message}")
        return False
    return True


def _eq(actual: object, expected: object, message: str) -> bool:
    return _check(actual == expected, f"{message}: expected {expected!r}, got {actual!r}")


def _touch(path: Path) -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("", encoding="utf-8")
    return path


def _remove(path: Path) -> None:
    path.unlink()


@contextlib.contextmanager
def _tree():
    with tempfile.TemporaryDirectory(prefix="oo_liveshare_test_") as tmp:
        root = Path(tmp)
        cwd = root / "cwd"
        script = root / "script"
        runs = root / "runs"
        experiment = runs / "exp"
        run_folder = experiment / "0"
        for folder in (cwd, script, experiment, run_folder):
            folder.mkdir(parents=True)

        yield {
            "root": root,
            "cwd": cwd,
            "script": script,
            "runs": runs,
            "experiment": experiment,
            "run": run_folder,
        }


def _decide(tree) -> object:
    return liveshare.decide(
        str(tree["run"]),
        cwd=str(tree["cwd"]),
        script_dir=str(tree["script"]),
    )


