class _Recorder:
    def __init__(self) -> None:
        self.events: List[str] = []
        self.lines: List[List[str]] = []

    def on_start(self) -> None:
        self.events.append("start")

    def on_stop(self) -> None:
        self.events.append("stop")

    def announce(self, lines: List[str]) -> None:
        self.events.append("announce")
        self.lines.append(list(lines))


def test_controller_activation() -> bool:
    recorder = _Recorder()
    state = liveshare.State()
    decision = liveshare.MarkerDecision(
        liveshare.MarkerAction.START, "run", "/runs/exp/0/liveshare"
    )
    controller = liveshare.Controller(
        state=state,
        share=lambda: (
            "See https://example.org/share?run_nr=0 for live-results.",
            "",
        ),
        announce=recorder.announce,
        on_start=recorder.on_start,
    )

    action = controller.apply(decision)
    joined = "\n".join(recorder.lines[0])

    return (
        _eq(action, liveshare.MarkerAction.START, "activation action")
        and _eq(recorder.events, ["start", "announce"], "callback order")
        and _check("https://example.org/share?run_nr=0" in joined, "URL announced")
        and _check(state.active, "state active")
    )


def test_controller_activation_only_once() -> bool:
    recorder = _Recorder()
    state = liveshare.State()
    decision = liveshare.MarkerDecision(
        liveshare.MarkerAction.START, "global", "/work/liveshare"
    )
    calls = {"share": 0}

    def share() -> Tuple[str, str]:
        calls["share"] += 1
        return "https://example.org/x", ""

    controller = liveshare.Controller(
        state=state,
        share=share,
        announce=recorder.announce,
        on_start=recorder.on_start,
    )

    first = controller.apply(decision)
    second = controller.apply(decision)

    return (
        _eq(first, liveshare.MarkerAction.START, "first activation")
        and _check(second is None, "second poll is a no-op")
        and _eq(calls["share"], 1, "share command runs exactly once")
        and _eq(recorder.events, ["start", "announce"], "one announcement")
    )


def test_controller_share_error_still_announces() -> bool:
    recorder = _Recorder()
    state = liveshare.State()
    decision = liveshare.MarkerDecision(
