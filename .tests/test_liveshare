def main() -> int:
    failures = 0
    for test in TESTS:
        print(f"running {test.__name__} ...", end=" ", flush=True)
        try:
            ok = test()
        except Exception as exc:  # noqa: BLE001
            ok = False
            red_text(f"\n  EXCEPTION: {exc!r}")
        if ok:
            print("ok")
        else:
            failures += 1
            print("FAIL")

    if failures:
        red_text(f"\n{failures} test(s) failed")
        return 1

    print(f"\nAll {len(TESTS)} live-share marker tests passed")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
