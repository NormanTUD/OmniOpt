# ---------------------------------------------------------------------------
# tqdm-aware writing
# ---------------------------------------------------------------------------


class _FakeProgressBar:
    def __init__(self, disable: bool = False, raise_on_write: bool = False):
        self.disable = disable
        self.fp = io.StringIO()
        self.raise_on_write = raise_on_write
        self.writes: List[Tuple[str, object]] = []

    def write(self, text: str, file: object = None) -> None:
        if self.raise_on_write:
            raise RuntimeError("write failed")
        self.writes.append((text, file))


def test_write_above_progress_bar_uses_tqdm() -> bool:
    progress = _FakeProgressBar()
    fallback: List[str] = []
    ok = liveshare.write_above_progress_bar(progress, "hello", fallback=fallback.append)
    return (
        _check(ok, "must report tqdm usage")
        and _eq(progress.writes, [("hello", progress.fp)], "text and stream passed to tqdm")
        and _eq(fallback, [], "fallback must not be used")
    )


def test_write_above_progress_bar_none_falls_back() -> bool:
    fallback: List[str] = []
    ok = liveshare.write_above_progress_bar(None, "hello", fallback=fallback.append)
    return (
        _check(not ok, "no tqdm usage")
        and _eq(fallback, ["hello"], "fallback used")
    )


def test_write_above_progress_bar_disabled_falls_back() -> bool:
    progress = _FakeProgressBar(disable=True)
    fallback: List[str] = []
    ok = liveshare.write_above_progress_bar(progress, "hello", fallback=fallback.append)
    return (
        _check(not ok, "disabled bar must not be used")
        and _eq(fallback, ["hello"], "fallback used")
        and _eq(progress.writes, [], "disabled bar not written")
    )


def test_write_above_progress_bar_without_write_falls_back() -> bool:
    fallback: List[str] = []
    ok = liveshare.write_above_progress_bar(object(), "hello", fallback=fallback.append)
    return (
        _check(not ok, "missing write method")
        and _eq(fallback, ["hello"], "fallback used")
    )


def test_write_above_progress_bar_write_error_falls_back() -> bool:
    progress = _FakeProgressBar(raise_on_write=True)
    fallback: List[str] = []
    ok = liveshare.write_above_progress_bar(progress, "hello", fallback=fallback.append)
    return (
        _check(not ok, "write error must not propagate")
        and _eq(fallback, ["hello"], "fallback used after error")
    )


