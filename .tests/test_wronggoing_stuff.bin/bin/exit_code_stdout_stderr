#!/usr/bin/env python3
"""exit_code_stdout_stderr - prints 'This has stdout' to stdout and
'This has stderr' to stderr, then exits with code 5."""

import sys


def main() -> int:
    print("This has stdout")
    print("This has stderr", file=sys.stderr)
    return 5


if __name__ == "__main__":
    sys.exit(main())
