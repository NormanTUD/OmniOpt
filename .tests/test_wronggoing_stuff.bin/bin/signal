#!/usr/bin/env python3
"""signal - waits 1s, then dies from SIGKILL (unhandled) so the shell
reports exit-code 137 and "Killed" in stderr."""

import os
import signal
import sys
import time


def main() -> int:
    print("Waiting for 1 seconds before sending SIGKILL signal...")
    time.sleep(1)
    print("Sending SIGKILL signal to self...")
    os.kill(os.getpid(), signal.SIGKILL)
    return 0


if __name__ == "__main__":
    sys.exit(main())
