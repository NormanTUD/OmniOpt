#!/usr/bin/env python3
"""signal_but_has_output - waits 1s, prints RESULT, then dies from
SIGKILL (unhandled). Prints "Killed" to stderr so the shell/OS message
the test checks for is present deterministically regardless of the
invoking shell."""

import os
import random
import signal
import sys
import time


def main() -> int:
    print("Waiting for 1 seconds before sending SIGKILL signal...")
    time.sleep(1)
    print(f"RESULT: {random.randint(0, 2**31 - 1)}")
    print("Sending SIGKILL signal to self...")
    print("Killed", file=sys.stderr)
    os.kill(os.getpid(), signal.SIGKILL)
    return 0


if __name__ == "__main__":
    sys.exit(main())
