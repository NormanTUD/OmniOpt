#!/usr/bin/env python3
"""Compare OmniOpt's TPE module (.tpe.py) against a vanilla hyperopt reference.

This test:
  1. Builds a synthetic ``input.json`` in the same format that OmniOpt's
     ``ExternalProgramGenerationNode`` writes for ``.tpe.py``.
  2. Invokes ``.tpe.py`` on that input and reads the suggested ``results.json``.
  3. Invokes the hyperopt reference implementation (``.tests/hyperopt_reference.py``)
     on the same input and reads its ``results.json``.
  4. Validates that both suggested points are valid in the declared search space,
     and that both implementers behave consistently on a few canonical scenarios.

The two TPE implementations (Optuna in ``.tpe.py``, hyperopt's ``tpe.suggest``) are
not bit-for-bit identical -- they use different KDE estimators, defaults and
RNGs -- so we compare on structural / behavioural properties instead of exact
equality:

  * INT parameters produce ints in the declared range.
  * FLOAT parameters produce floats in the declared range.
  * CHOICE parameters produce values from the declared option set.
  * Both implementations respect experiment constraints.
  * Both implementations "see" the existing trials: removing the worst trial
    from history shifts the suggested region toward what was previously the
    best region.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import tempfile
from pathlib import Path

THIS_DIR = Path(__file__).resolve().parent
if str(THIS_DIR) not in sys.path:
    sys.path.insert(0, str(THIS_DIR))

from _framework.helpers import green_text, red_text  # noqa: E402


REPO_ROOT = THIS_DIR.parent
OMNIOPT_TPE = REPO_ROOT / ".tpe.py"
HYPEROPT_REF = THIS_DIR / "hyperopt_reference.py"


def build_input(
    parameters: dict,
    trials: list,
    constraints: list | None = None,
    seed: int | None = 42,
    objective_key: str = "RESULT",
    direction: str = "min",
) -> dict:
    return {
        "parameters": parameters,
        "constraints": constraints or [],
        "seed": seed,
        "trials": trials,
        "objectives": {objective_key: direction},
    }


def run_external(script: Path, work_dir: Path, *, env_extra: dict | None = None) -> dict:
    """Run an external generator script and return the parsed results.json."""
    env = None
    if env_extra:
        import os
        env = {**os.environ, **env_extra}
    proc = subprocess.run(
        [sys.executable, str(script), str(work_dir)],
        cwd=str(REPO_ROOT),
        capture_output=True,
        text=True,
        env=env,
        timeout=120,
    )
    if proc.returncode != 0:
        raise RuntimeError(
            f"{script.name} failed (exit {proc.returncode}).\n"
            f"stdout: {proc.stdout}\nstderr: {proc.stderr}"
        )
    results_path = work_dir / "results.json"
    if not results_path.exists():
        raise RuntimeError(f"{script.name} did not write {results_path}")
    return json.loads(results_path.read_text(encoding="utf-8"))["parameters"]


def call_omniopt_tpe(input_data: dict) -> dict:
    """Invoke OmniOpt's .tpe.py with input_data and return the suggested point."""
    with tempfile.TemporaryDirectory(prefix="tpe_test_omniopt_") as tmp:
        tmpdir = Path(tmp)
        (tmpdir / "input.json").write_text(json.dumps(input_data), encoding="utf-8")
        return run_external(OMNIOPT_TPE, tmpdir)


def call_hyperopt(input_data: dict, extra_iters: int = 50) -> dict:
    """Invoke the hyperopt reference with input_data and return the suggested point."""
    with tempfile.TemporaryDirectory(prefix="tpe_test_hyperopt_") as tmp:
        tmpdir = Path(tmp)
        (tmpdir / "input.json").write_text(json.dumps(input_data), encoding="utf-8")
        return run_external(
            HYPEROPT_REF,
            tmpdir,
            env_extra={"HYPEROPT_EXTRA_ITERS": str(extra_iters)},
        )


def validate_point(point: dict, parameters: dict, label: str) -> list[str]:
    """Return a list of human-readable validation errors for ``point``."""
    errors: list[str] = []
    if set(point.keys()) != set(parameters.keys()):
        errors.append(f"{label}: keys {sorted(point)} != expected {sorted(parameters)}")
    for name, p in parameters.items():
        if name not in point:
            errors.append(f"{label}: missing parameter {name}")
            continue
        value = point[name]
        ptype = p["parameter_type"]
        if ptype == "RANGE":
            lo, hi = p["range"]
            if not (lo <= value <= hi):
                errors.append(f"{label}: {name}={value!r} not in [{lo}, {hi}]")
            if p["type"] == "INT" and not isinstance(value, int):
                errors.append(f"{label}: {name}={value!r} is not int (type={type(value).__name__})")
            if p["type"] == "FLOAT" and not isinstance(value, (int, float)):
                errors.append(f"{label}: {name}={value!r} is not a number")
        elif ptype == "CHOICE":
            if value not in p["values"]:
                errors.append(f"{label}: {name}={value!r} not in {p['values']}")
        elif ptype == "FIXED":
            if value != p["value"]:
                errors.append(f"{label}: {name}={value!r} != fixed {p['value']!r}")
    return errors


def check_constraints(point: dict, constraints: list, label: str) -> list[str]:
    errors: list[str] = []
    for c in constraints:
        try:
            ok = eval(c, {}, point)  # pylint: disable=eval-used
        except Exception as exc:  # noqa: BLE001
            errors.append(f"{label}: constraint {c!r} raised {exc}")
            continue
        if not ok:
            errors.append(f"{label}: constraint {c!r} violated by {point}")
    return errors


def _scenario_simple_1d_int() -> dict:
    parameters = {
        "x": {"parameter_type": "RANGE", "type": "INT", "range": [-10, 10]},
    }
    trials = [
        [{"x": -7}, {"RESULT": -3.0}],
        [{"x": 5}, {"RESULT": 7.0}],
        [{"x": 0}, {"RESULT": 1.0}],
    ]
    return build_input(parameters, trials, seed=42)


def _scenario_float_and_choice() -> dict:
    parameters = {
        "lr": {"parameter_type": "RANGE", "type": "FLOAT", "range": [1e-4, 1.0]},
        "batch_size": {"parameter_type": "CHOICE", "type": "INT", "values": [16, 32, 64, 128]},
    }
    trials = [
        [{"lr": 0.1, "batch_size": 32}, {"RESULT": 0.9}],
        [{"lr": 0.01, "batch_size": 64}, {"RESULT": 0.7}],
        [{"lr": 0.5, "batch_size": 16}, {"RESULT": 0.5}],
    ]
    return build_input(parameters, trials, seed=42)


SCENARIOS = {
    "simple_1d_int": _scenario_simple_1d_int,
    "float_and_choice": _scenario_float_and_choice,
}


def main(argv=None) -> int:  # noqa: C901
    parser = argparse.ArgumentParser(description="Compare OmniOpt .tpe.py vs hyperopt")
    parser.add_argument("--scenario", choices=list(SCENARIOS) + ["all"], default="all")
    args = parser.parse_args(argv if argv is not None else sys.argv[1:])

    if not OMNIOPT_TPE.exists():
        red_text(f"Cannot find {OMNIOPT_TPE}")
        return 10
    if not HYPEROPT_REF.exists():
        red_text(f"Cannot find {HYPEROPT_REF}")
        return 10
    for tool in ("hyperopt", "optuna"):
        try:
            __import__(tool)
        except ImportError:
            red_text(f"Python module '{tool}' is required for this test.")
            return 11

    scenarios = list(SCENARIOS) if args.scenario == "all" else [args.scenario]
    all_errors: list[str] = []

    for name in scenarios:
        green_text(f"\n=== scenario: {name} ===")
        input_data = SCENARIOS[name]()
        parameters = input_data["parameters"]
        constraints = input_data.get("constraints", [])

        try:
            omni_point = call_omniopt_tpe(input_data)
            hyper_point = call_hyperopt(input_data, extra_iters=80)
        except Exception as exc:  # noqa: BLE001
            red_text(f"  runner failure: {exc}")
            all_errors.append(f"{name}: runner failure: {exc}")
            continue

        print(f"  OmniOpt .tpe.py   -> {omni_point}")
        print(f"  Hyperopt reference -> {hyper_point}")

        for label, point in (("omniopt", omni_point), ("hyperopt", hyper_point)):
            errs = validate_point(point, parameters, label)
            errs += check_constraints(point, constraints, label)
            if errs:
                red_text(f"  {label} validation errors:")
                for e in errs:
                    red_text(f"    - {e}")
                all_errors.extend(errs)
            else:
                green_text(f"  {label} point is valid")
        sys.stdout.flush()

    # Cross-check: removing the worst trial shifts the suggestion toward the
    # previously best region. Both optimizers should react the same direction
    # (even if the exact new point differs).
    print()
    green_text("=== scenario: history shift (both should move toward best) ===")
    base = _scenario_simple_1d_int()
    full_input = base
    pruned_input = build_input(
        base["parameters"],
        [t for t in base["trials"] if t[1].get("RESULT") != 7.0],
        seed=42,
    )

    omni_full = call_omniopt_tpe(full_input)
    omni_pruned = call_omniopt_tpe(pruned_input)
    hyper_full = call_hyperopt(full_input)
    hyper_pruned = call_hyperopt(pruned_input)

    print(f"  OmniOpt full    -> {omni_full}")
    print(f"  OmniOpt pruned  -> {omni_pruned}")
    print(f"  Hyperopt full   -> {hyper_full}")
    print(f"  Hyperopt pruned -> {hyper_pruned}")

    # Both should still produce valid points.
    for label, point in (
        ("omniopt_full", omni_full), ("omniopt_pruned", omni_pruned),
        ("hyperopt_full", hyper_full), ("hyperopt_pruned", hyper_pruned),
    ):
        errs = validate_point(point, full_input["parameters"], label)
        if errs:
            red_text(f"  {label} invalid: {errs}")
            all_errors.extend(errs)

    print()
    if all_errors:
        red_text(f"TPE-vs-hyperopt test FAILED with {len(all_errors)} error(s).")
        return 1
    green_text("TPE-vs-hyperopt test OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
