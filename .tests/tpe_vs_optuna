#!/usr/bin/env python3
"""Verify that OmniOpt's TPE generator agrees with hyperopt called as a module.

This test parametrizes a TPE run with a configurable number of iterations
(``--num_evals``) and asserts that the point OmniOpt's external generator
(``.tpe.py``) returns is the same point that hyperopt's ``tpe.suggest``
returns when invoked directly in-process with the exact same search space,
seed and replayed history.

The point of the test is to lock in the contract between OmniOpt's
``ExternalProgramGenerationNode`` and the hyperopt-based generator: a future
refactor of ``.tpe.py`` must not silently change which point is suggested for
a given (parameters, constraints, trials, seed, num_evals) tuple.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

THIS_DIR = Path(__file__).resolve().parent
if str(THIS_DIR) not in sys.path:
    sys.path.insert(0, str(THIS_DIR))

from _framework.helpers import green_text, red_text  # noqa: E402


REPO_ROOT = THIS_DIR.parent
HYPEROPT_TPE = REPO_ROOT / ".tpe.py"


def _ensure_deps() -> None:
    """Make sure hyperopt / optuna / beartype / numpy are importable.

    Mirrors the pattern used by ``.tests/pyflakes``, ``.tests/mypy`` etc.:
    first let the framework venv provide them via ``ensure_dependencies``,
    then fall back to ``install_packages`` for anything still missing.
    """
    os.environ.setdefault("install_tests", "1")
    from _framework.installer import ensure_dependencies, install_packages  # noqa: E402
    ensure_dependencies(include_tests=True)

    missing = []
    for mod in ("hyperopt", "optuna", "beartype", "numpy"):
        try:
            __import__(mod)
        except ImportError:
            missing.append(mod)
    if missing:
        print(f"Installing missing dependencies: {missing}")
        install_packages(missing, quiet=False)
        for mod in missing:
            __import__(mod)


def build_input(
    parameters: dict,
    trials: list,
    constraints: list | None = None,
    seed: int | None = 42,
    objective_key: str = "RESULT",
    direction: str = "min",
) -> dict:
    return {
        "parameters": parameters,
        "constraints": constraints or [],
        "seed": seed,
        "trials": trials,
        "objectives": {objective_key: direction},
    }


def run_omniopt_tpe(input_data: dict, num_evals: int, work_dir: Path) -> dict:
    """Invoke ``.tpe.py`` as a subprocess and return the suggested point."""
    (work_dir / "input.json").write_text(json.dumps(input_data), encoding="utf-8")
    env = os.environ.copy()
    env["OMNIOPT_TPE_EXTRA_ITERS"] = str(num_evals)
    proc = subprocess.run(
        [sys.executable, str(HYPEROPT_TPE), str(work_dir)],
        cwd=str(REPO_ROOT),
        capture_output=True,
        text=True,
        env=env,
        timeout=180,
    )
    if proc.returncode != 0:
        raise RuntimeError(
            f".tpe.py failed (exit {proc.returncode}).\n"
            f"stdout: {proc.stdout}\nstderr: {proc.stderr}"
        )
    results_path = work_dir / "results.json"
    if not results_path.exists():
        raise RuntimeError(f".tpe.py did not write {results_path}")
    return json.loads(results_path.read_text(encoding="utf-8"))["parameters"]


def run_hyperopt_in_process(input_data: dict, num_evals: int) -> dict:
    """Run hyperopt's tpe.suggest in-process with the same setup as .tpe.py.

    This is the "hyperopt as module" half of the comparison: the same search
    space, the same recorded trial history (replayed in order), the same seed,
    and the same number of TPE iterations. The objective factory mirrors
    ``.tpe.py:make_objective`` exactly so the two paths consume the same
    information in the same order.
    """
    from hyperopt import fmin, tpe, Trials  # noqa: E402
    import numpy as np  # noqa: E402

    # Import the module under test so we reuse its helpers.
    import importlib.util  # noqa: E402
    spec = importlib.util.spec_from_file_location("tpe_under_test", str(HYPEROPT_TPE))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)  # type: ignore[union-attr]

    parameters = input_data["parameters"]
    constraints = input_data.get("constraints", []) or []
    seed = input_data.get("seed", None)
    trials_data = input_data.get("trials", []) or []
    objectives = input_data.get("objectives", {})

    direction, result_key = mod.parse_objectives(objectives)
    space = mod.build_space(parameters)
    known = mod.extract_known_trials(trials_data, result_key)
    objective = mod.make_objective(known, constraints, direction)

    trials = Trials()
    max_evals = max(len(known) + num_evals, 1)
    rng = np.random.default_rng(seed)

    fmin(
        fn=objective,
        space=space,
        algo=tpe.suggest,
        trials=trials,
        max_evals=max_evals,
        verbose=False,
        rstate=rng,
    )

    new_suggestions = list(trials.trials[len(known):])
    if new_suggestions:
        chosen = new_suggestions[-1]["misc"]["vals"]
    else:
        chosen = trials.best_trial["misc"]["vals"]
    return mod._decode_trial(chosen, parameters)


def validate_point(point: dict, parameters: dict, label: str) -> list[str]:
    errors: list[str] = []
    if set(point.keys()) != set(parameters.keys()):
        errors.append(f"{label}: keys {sorted(point)} != expected {sorted(parameters)}")
    for name, p in parameters.items():
        if name not in point:
            errors.append(f"{label}: missing parameter {name}")
            continue
        value = point[name]
        ptype = p["parameter_type"]
        if ptype == "RANGE":
            lo, hi = p["range"]
            if not (lo <= value <= hi):
                errors.append(f"{label}: {name}={value!r} not in [{lo}, {hi}]")
            if p["type"] == "INT" and not isinstance(value, int):
                errors.append(f"{label}: {name}={value!r} is not int (type={type(value).__name__})")
            if p["type"] == "FLOAT" and not isinstance(value, (int, float)):
                errors.append(f"{label}: {name}={value!r} is not a number")
        elif ptype == "CHOICE":
            if value not in p["values"]:
                errors.append(f"{label}: {name}={value!r} not in {p['values']}")
        elif ptype == "FIXED":
            if value != p["value"]:
                errors.append(f"{label}: {name}={value!r} != fixed {p['value']!r}")
    return errors


def check_constraints(point: dict, constraints: list, label: str) -> list[str]:
    errors: list[str] = []
    for c in constraints:
        try:
            ok = eval(c, {}, point)  # pylint: disable=eval-used
        except Exception as exc:  # noqa: BLE001
            errors.append(f"{label}: constraint {c!r} raised {exc}")
            continue
        if not ok:
            errors.append(f"{label}: constraint {c!r} violated by {point}")
    return errors


def _scenario_int() -> dict:
    return build_input(
        {
            "x": {"parameter_type": "RANGE", "type": "INT", "range": [-10, 10]},
        },
        [
            [{"x": -7}, {"RESULT": -3.0}],
            [{"x": 5}, {"RESULT": 7.0}],
            [{"x": 0}, {"RESULT": 1.0}],
        ],
        seed=42,
    )


def _scenario_float_choice() -> dict:
    return build_input(
        {
            "lr": {"parameter_type": "RANGE", "type": "FLOAT", "range": [1e-4, 1.0]},
            "bs": {"parameter_type": "CHOICE", "type": "INT", "values": [16, 32, 64, 128]},
        },
        [
            [{"lr": 0.1, "bs": 32}, {"RESULT": 0.9}],
            [{"lr": 0.01, "bs": 64}, {"RESULT": 0.7}],
        ],
        seed=42,
    )


def _scenario_empty_history() -> dict:
    return build_input(
        {
            "x": {"parameter_type": "RANGE", "type": "INT", "range": [0, 5]},
            "y": {"parameter_type": "RANGE", "type": "FLOAT", "range": [0.0, 1.0]},
        },
        [],
        seed=42,
    )


def _scenario_with_constraint() -> dict:
    return build_input(
        {
            "x": {"parameter_type": "RANGE", "type": "INT", "range": [0, 20]},
            "y": {"parameter_type": "RANGE", "type": "INT", "range": [0, 20]},
        },
        [
            [{"x": 2, "y": 18}, {"RESULT": 1.0}],
            [{"x": 10, "y": 10}, {"RESULT": 5.0}],
        ],
        constraints=["x + y >= 5"],
        seed=42,
    )


SCENARIOS = {
    "int": _scenario_int,
    "float_choice": _scenario_float_choice,
    "empty_history": _scenario_empty_history,
    "with_constraint": _scenario_with_constraint,
}


def _points_equal(a: dict, b: dict) -> bool:
    """Equality that tolerates int/float interchange but not real differences."""
    if set(a.keys()) != set(b.keys()):
        return False
    for k in a:
        va, vb = a[k], b[k]
        if isinstance(va, float) or isinstance(vb, float):
            if not isinstance(va, (int, float)) or not isinstance(vb, (int, float)):
                return False
            if abs(float(va) - float(vb)) > 1e-9:
                return False
        elif va != vb:
            return False
    return True


def main(argv=None) -> int:  # noqa: C901
    parser = argparse.ArgumentParser(
        description="Compare OmniOpt .tpe.py (subprocess) vs hyperopt (in-process)"
    )
    parser.add_argument("--num_evals", type=int, default=50,
                        help="Number of TPE iterations to run per call (default: 50)")
    parser.add_argument("--scenario", choices=list(SCENARIOS) + ["all"], default="all")
    args = parser.parse_args(argv if argv is not None else sys.argv[1:])

    if not HYPEROPT_TPE.exists():
        red_text(f"Cannot find {HYPEROPT_TPE}")
        return 10

    try:
        _ensure_deps()
    except SystemExit as exc:
        return int(exc.code) if isinstance(exc.code, int) else 20

    scenarios = list(SCENARIOS) if args.scenario == "all" else [args.scenario]
    all_errors: list[str] = []

    for name in scenarios:
        green_text(f"\n=== scenario: {name} (num_evals={args.num_evals}) ===")
        input_data = SCENARIOS[name]()
        parameters = input_data["parameters"]
        constraints = input_data.get("constraints", [])

        try:
            with tempfile.TemporaryDirectory(prefix="tpe_vs_optuna_sub_") as tmp:
                sub_point = run_omniopt_tpe(input_data, args.num_evals, Path(tmp))
            inproc_point = run_hyperopt_in_process(input_data, args.num_evals)
        except Exception as exc:  # noqa: BLE001
            red_text(f"  runner failure: {exc}")
            all_errors.append(f"{name}: runner failure: {exc}")
            continue

        print(f"  .tpe.py (subprocess)  -> {sub_point}")
        print(f"  hyperopt (in-process) -> {inproc_point}")

        for label, point in (("subprocess", sub_point), ("in-process", inproc_point)):
            errs = validate_point(point, parameters, label)
            errs += check_constraints(point, constraints, label)
            if errs:
                red_text(f"  {label} validation errors:")
                for e in errs:
                    red_text(f"    - {e}")
                all_errors.extend(errs)
            else:
                green_text(f"  {label} point is valid")

        if _points_equal(sub_point, inproc_point):
            green_text("  points MATCH")
        else:
            msg = f"  points DIFFER: sub={sub_point} inproc={inproc_point}"
            red_text(msg)
            all_errors.append(msg)
        sys.stdout.flush()

    print()
    if all_errors:
        red_text(f"TPE-vs-hyperopt test FAILED with {len(all_errors)} error(s).")
        return 1
    green_text("TPE-vs-hyperopt test OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
