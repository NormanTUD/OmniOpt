    vals = {"xi": [2.7], "xf": [0.5], "c": [1], "f": [99], "unknown": [3]}
    point = tpe_mod._decode_trial(vals, parameters)
    ok = _check(point["xi"] == 3, f"INT should round, got {point['xi']}")
    ok &= _check(point["xf"] == 0.5, f"FLOAT should stay float, got {point['xf']}")
    ok &= _check(point["c"] == "b", f"CHOICE should map to value, got {point['c']}")
    ok &= _check(point["f"] == 7, f"FIXED should use configured value, got {point['f']}")
    ok &= _check(point["unknown"] == 3, f"unknown params pass through, got {point['unknown']}")
    empty = tpe_mod._decode_trial({"xi": []}, parameters)
    ok &= _check(empty["xi"] is None, f"empty vals -> None, got {empty['xi']}")
    return ok


