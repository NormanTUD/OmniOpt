def main() -> int:
    failures = 0
    skipped = 0
    for t in TESTS:
        if tpe_mod is None and t in TPE_TESTS:
            print(f"skipping {t.__name__} (hyperopt not available)")
            skipped += 1
            continue
        print(f"running {t.__name__} ...", end=" ", flush=True)
        try:
            ok = t()
        except Exception as exc:  # noqa: BLE001
            ok = False
            red_text(f"\n  EXCEPTION: {exc!r}")
        if ok:
            print("ok")
        else:
            failures += 1
            print("FAIL")
    if failures:
        red_text(f"\n{failures} test(s) failed")
        return 1
    if skipped:
        print(f"\nAll runnable unit tests passed ({skipped} skipped)")
    else:
        print("\nAll unit tests passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
