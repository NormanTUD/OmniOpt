def _load(name: str, location: Path):
    # pylint: disable-next=deprecated-method
    return SourceFileLoader(name, str(location)).load_module()


helpers_util = _load("helpers_util", REPO_ROOT / ".helpers.py")
pareto_mod = _load("pareto_mod", REPO_ROOT / ".pareto.py")
random_gen = _load("random_gen", REPO_ROOT / ".random_generator.py")
try:
    tpe_mod = _load("tpe_mod", REPO_ROOT / ".tpe.py")
except (ImportError, SystemExit):
    # hyperopt/beartype may be missing outside the venv; the tpe tests
    # are skipped in that case.
    tpe_mod = None
general_mod = _load("general_mod", REPO_ROOT / ".general.py")


def _check(condition: bool, message: str) -> bool:
    if not condition:
        red_text(f"FAIL: {message}")
        return False
    return True


@contextlib.contextmanager
def _env(key: str, value: str | None):
    """Temporarily set (or unset) an environment variable."""
    old = os.environ.get(key)
    if value is None:
        os.environ.pop(key, None)
    else:
        os.environ[key] = value
    try:
        yield
    finally:
        if old is None:
            os.environ.pop(key, None)
        else:
            os.environ[key] = old


def _expect_exit(fn, code: int, message: str) -> bool:
    try:
        fn()
    except SystemExit as exc:
        return _check(exc.code == code, f"{message}: expected exit {code}, got {exc.code}")
    return _check(False, f"{message}: expected SystemExit({code}), but no exit happened")


