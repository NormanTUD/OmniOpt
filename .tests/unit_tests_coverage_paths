def test_optuna_runner_pure_helpers() -> bool:
    if optuna_runner is None:
        return True
    ok = optuna_runner.parse_objectives({"r": "min"}) == (["minimize"], ["r"])
    try:
        optuna_runner.parse_objectives({})
        ok = False
    except ValueError:
        pass
    try:
        optuna_runner.parse_objectives({"r": "nope"})
        ok = False
    except ValueError:
        pass
    ok &= optuna_runner.check_constraint("x > 1", {"x": 2}) is True
    ok &= optuna_runner.constraint_violated([], {}) is False
    ok &= optuna_runner.constraint_violated(["x > 1"], {"x": 0}) is True
    ok &= optuna_runner.decode_trial_values({"i": "2.6", "f": "x", "c": "a"}, {
        "i": {"parameter_type": "RANGE", "range": [0, 3], "type": "INT"},
        "f": {"parameter_type": "RANGE", "range": [0, 1], "type": "FLOAT"},
        "c": {"parameter_type": "CHOICE", "values": ["a"]},
    }) == {"i": 3, "f": "x", "c": "a"}
    ok &= optuna_runner.extract_known_trials([[], []], ["r"], {}) == []
    ok &= optuna_runner.extract_known_trials([["x"], []], ["r"], {}) == []
    ok &= optuna_runner.extract_known_trials([[{}], [{}]], ["r"], {}) == []
    ok &= optuna_runner.extract_known_trials(
        [[{"x": 1}], [{"r": 2}]],
        ["r"],
        {"x": {"parameter_type": "RANGE", "range": [0, 1], "type": "INT"}},
    )[0][0] == {"x": 1}
    ok &= optuna_runner._resolve_sampler_name("TPE") == "TPESampler"
    ok &= optuna_runner._resolve_pruner_name("NONE") == "NopPruner"
    for fn, bad in ((optuna_runner._resolve_sampler_name, "x"), (optuna_runner._resolve_pruner_name, "x")):
        try:
            fn(bad)
            ok = False
        except ValueError:
            pass
    ok &= optuna_runner._resolve_seed({"seed": "5"}, None) == 5
    ok &= optuna_runner._resolve_seed({"seed": "bad"}, None) is None
    ok &= optuna_runner._resolve_seed({}, 7) == 7
    ok &= optuna_runner._resolve_seed({}, None) is None
    with _env(OMNIOPT_OPTUNA_EXTRA_ITERS="bad"):
        ok &= optuna_runner._resolve_extra_iters() == 1
    with _env(OMNIOPT_OPTUNA_EXTRA_ITERS="0"):
        ok &= optuna_runner._resolve_extra_iters() == 1
    ok &= optuna_runner._infer_param_spec(True)["parameter_type"] == "CHOICE"
    ok &= optuna_runner._infer_param_spec(2)["type"] == "INT"
    ok &= optuna_runner._infer_param_spec(2.5)["type"] == "FLOAT"
    ok &= optuna_runner._infer_param_spec("x")["parameter_type"] == "CHOICE"
    ok &= optuna_runner._expand_params_spec({"x": 1})["x"]["type"] == "INT"
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        try:
            optuna_runner._resolve_storage(None, None)
            ok = False
        except ValueError:
            pass
        ok &= optuna_runner._resolve_storage(str(root / "x.db"), None).endswith("x.db")
        ok &= optuna_runner._resolve_storage(None, root).startswith("sqlite:///")
        json_file = root / "x.json"
        json_file.write_text('{"a": 1}')
        ok &= optuna_runner._read_json_arg("@" + str(json_file)) == {"a": 1}
        ok &= optuna_runner._read_json_arg('{"b": 2}') == {"b": 2}
        try:
            optuna_runner._load_input(root)
            ok = False
        except FileNotFoundError:
            pass
    ok &= optuna_runner._env_int("NO_SUCH_ENV", 3) == 3
    with _env(COVERAGE_ENV_INT="bad"):
        ok &= optuna_runner._env_int("COVERAGE_ENV_INT", 4) == 4
    with _env(COVERAGE_ENV_BOOL="yes"):
        ok &= optuna_runner._env_bool("COVERAGE_ENV_BOOL", False) is True
    with _env(COVERAGE_ENV_BOOL=None):
        ok &= optuna_runner._env_bool("COVERAGE_ENV_BOOL", True) is True
    return ok


