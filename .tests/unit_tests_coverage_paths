            ok = test()
        except Exception as exc:  # noqa: BLE001
            ok = False
            red_text(f"\n  EXCEPTION: {exc!r}")
        if ok:
            print("ok")
        else:
            failures += 1
            print("FAIL")
    if failures:
        red_text(f"\n{failures} test(s) failed")
