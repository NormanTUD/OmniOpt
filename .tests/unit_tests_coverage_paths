def test_helpers_resolve_git_version() -> bool:
    old_hash = helpers._read_git_hash
    old_run_git = helpers._run_git
    results = {}
    helpers._read_git_hash = lambda _d: "hash"
    helpers._run_git = lambda _d, *args, **kwargs: results.get(args, "")
    try:
        ok = helpers.resolve_git_version(".") == ("print", "Current git-hash: hash")
        results[("describe", "--tags", "--abbrev=0")] = "v1"
        ok &= helpers.resolve_git_version(".") == ("print", "Current git-hash: hash (version: v1)")
        results[("rev-list", "-n", "1", "v1")] = "taghash"
        ok &= helpers.resolve_git_version(".") == (
            "print",
            "Current git-hash: hash (version: v1, taghash)",
        )
        results[("rev-list", "--count", "taghash..HEAD")] = "abc"
        ok &= helpers.resolve_git_version(".") == ("print", "Current git-hash: hash (version: v1)")
        results[("rev-list", "--count", "taghash..HEAD")] = "0"
        ok &= helpers.resolve_git_version(".") == ("print", "Current git-hash: hash (v1, taghash)")
        results[("rev-list", "--count", "taghash..HEAD")] = "2"
        ok &= helpers.resolve_git_version(".", checkout_to_latest=True) == ("checkout", "taghash")
        with _env(OO_MAIN_TESTS="1"):
            action, message = helpers.resolve_git_version(".")
            ok &= action == "print" and "2 commits" in message and "not thoroughly tested" not in message
        with _env(OO_MAIN_TESTS=None):
            action, message = helpers.resolve_git_version(".")
            ok &= action == "print" and "not thoroughly tested" in message
        helpers._read_git_hash = lambda _d: "NOT_DETERMININABLE"
        results.clear()
        ok &= helpers.resolve_git_version(".") == ("none", "")
    finally:
        helpers._read_git_hash = old_hash
        helpers._run_git = old_run_git
    return ok


