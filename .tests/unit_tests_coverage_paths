        "x": {"parameter_type": "FIXED", "value": 7},
        "unknown": {"parameter_type": "OTHER", "values": [1]},
    }
    point = tpe._decode_trial(
        {"i": [1.4], "f": [0.5], "c": [1.0], "x": [1], "unknown": [2]}, parameters
    )
    ok &= point == {"i": 1, "f": 0.5, "c": "b", "x": 7, "unknown": 2.0}
    ok &= tpe._decode_trial({"i": []}, parameters) == {"i": None}
    with _env(OMNIOPT_TPE_EXTRA_ITERS="nope"):
        ok &= tpe._resolve_extra_iters() == 50
    with _env(OMNIOPT_TPE_EXTRA_ITERS="-2"):
        ok &= tpe._resolve_extra_iters() == 0
    with _env(OMNIOPT_TPE_EXTRA_ITERS=None):
        ok &= tpe._resolve_extra_iters() == 50
    old_argv = sys.argv
    try:
        sys.argv = ["tpe"]
        ok &= _expect_exit(tpe.main, 1)
        sys.argv = ["tpe", "/definitely/not/here"]
        ok &= _expect_exit(tpe.main, 2)
        with tempfile.TemporaryDirectory() as tmp:
            sys.argv = ["tpe", tmp]
            ok &= _expect_exit(tpe.main, 3)
            Path(tmp, "input.json").write_text("{")
            ok &= _expect_exit(tpe.main, 4)
    finally:
        sys.argv = old_argv
    return ok


