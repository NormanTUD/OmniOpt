        empty_merge = helpers.merge_df_with_old_data(
            _args(run_dir=str(run), merge_with_previous_runs=[]), df, None, None, ""
        )
        ok &= _check(len(empty_merge) == len(df), "merge without previous runs")

        loaded = helpers.load_and_merge_data(
            _args(run_dir=str(run)), None, None, False, str(run / "results.csv")
        )
        ok &= _check(loaded is not None and not loaded.empty, "load_and_merge_data")
        missing = helpers.load_and_merge_data(
            _args(run_dir=str(run)), None, None, False, str(root / "missing.csv")
        )
        ok &= _check(missing is None, "load_and_merge_data missing file")

        filtered = helpers.filter_data(
            _args(run_dir=str(run)), df, 2.0, 3.0, str(run / "results.csv")
        )
        ok &= _check(len(filtered) == 2, "filter_data min/max")
        no_result = pd.DataFrame({"other": [1]})
        ok &= _check(_expect_exit(
            lambda: helpers.filter_data(
                _args(run_dir=str(run)), no_result, 1.0, None, str(run / "results.csv")
            ), 19
        ), "filter_data missing result column")

        args_check = _args(run_dir=str(run), min=3, max=1)
        with contextlib.redirect_stdout(io.StringIO()):
            helpers.check_args(args_check)
        ok &= _check(args_check.min == 1 and args_check.max == 3, "check_args swaps min/max")
        args_same = _args(run_dir=str(run), min=2, max=2)
