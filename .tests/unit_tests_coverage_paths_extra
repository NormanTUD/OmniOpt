        zip_path = root / "share.zip"
        with zipfile.ZipFile(zip_path, "w") as zf:
            zf.writestr("results.csv", "result\n1\n")

        class ZipResponse:
            def __init__(self, path):
                self.fh = open(path, "rb")

            def __enter__(self):
                return self.fh

            def __exit__(self, *exc):
                self.fh.close()
                return False

        runs = root / "runs" / "user" / "exp"
        (runs / "0").mkdir(parents=True)
        old = helpers.urllib.request.urlopen
        helpers.urllib.request.urlopen = lambda *a, **k: ZipResponse(zip_path)
        try:
            target = helpers.download_share_run(
                "https://x/share.php?user_id=user&experiment_name=exp&run_nr=0",
                runs_root=str(root / "runs"),
            )
            ok &= _check(target is not None and Path(target).name == "1", "download collision bump")
        finally:
            helpers.urllib.request.urlopen = old
        helpers.urllib.request.urlopen = mock.MagicMock(side_effect=urllib.error.URLError("down"))
        try:
            ok &= _check(helpers.download_share_run(
                "https://x/share.php?user_id=user&experiment_name=exp&run_nr=0",
                runs_root=str(root / "runs"),
            ) is None, "download network failure")
        finally:
            helpers.urllib.request.urlopen = old
    return ok


