                ok &= _check(share._share_one_with(
                    args, "user", str(run), "http://base", post_manifest=post_ok
                ) == 1, "share refuses invalid bundle")

        failed_run = _write_run(root, extra={"trial_status": ["COMPLETED"] * 3})
        sr = failed_run / "single_runs" / "0"
