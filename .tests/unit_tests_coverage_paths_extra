def _input(workdir: Path, parameters, objectives, trials=None, constraints=None) -> None:
    data = {
        "parameters": parameters,
        "objectives": objectives,
        "trials": trials if trials is not None else [[], []],
        "constraints": constraints or [],
    }
    (workdir / "input.json").write_text(json.dumps(data))


def _params() -> dict:
    return {
        "x": {"parameter_type": "RANGE", "range": [0, 5], "type": "INT"},
        "f": {"parameter_type": "RANGE", "range": [0.0, 1.0], "type": "FLOAT"},
        "c": {"parameter_type": "CHOICE", "values": ["a", "b"]},
        "fixed": {"parameter_type": "FIXED", "value": 3},
    }


