        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            ok &= _check(share.main(["--username", "user", str(run)],
                                    post_manifest=post_ok) == 0, "share main")
            ok &= _check(share.main(["--username", "user", str(run), str(root / "missing")],
                                    post_manifest=post_ok) != 0, "share main reports failures")
    return ok


