def test_pareto_extra_paths() -> bool:
    x = np.array([0.0, 1.0, 2.0])
    y = np.array([2.0, 1.0, 0.0])
    ok = _check(len(pareto.pareto_front_general([], [], True, True)) == 0,
                "pareto handles invalid input")
    ok &= _check(pareto._point_dominates(2, 2, 1, 1, True, True) is True,
                 "point dominance minimize")
    ok &= _check(pareto._point_dominates(2, 1, 1, 2, True, True) is False,
                 "point non-dominance")
    dominated = pareto._find_dominated(x, y, False, False)
    ok &= _check(dominated.dtype == bool, "_find_dominated maximize")
