def test_helpers_usage_stats_and_download_edges() -> bool:
    calls = []
    old_urlopen = helpers._urlopen_quiet
    old_get_anon = helpers.get_anon_user_id
    helpers._urlopen_quiet = lambda url, timeout=5.0: calls.append(url) or True
    try:
        with _env(OO_MAIN_TESTS="1", ITWORKSONMYMACHINE=None,
                  CUSTOM_VIRTUAL_ENV="1", OMNIOPT_BASE_URL="http://base"):
            helpers.send_anonymized_usage_stats(True, "", "", None, 0)
        ok = _check(bool(calls), "usage stats request fired")
        ok &= _check("git_hash=pipinstall" in calls[-1], "pipinstall git hash")
        ok &= _check("exit_code=-1" in calls[-1] and "runtime=0" in calls[-1], "stats defaults")
        calls.clear()
        helpers.get_anon_user_id = mock.MagicMock(side_effect=RuntimeError("nope"))
        with _env(OO_MAIN_TESTS=None, ITWORKSONMYMACHINE=None):
            helpers.send_anonymized_usage_stats(False, "uuid", "hash", 1, 2)
        ok &= _check(not calls, "usage stats swallows anon-id failures")
    finally:
        helpers._urlopen_quiet = old_urlopen
        helpers.get_anon_user_id = old_get_anon

    with mock.patch.object(helpers.os, "getgroups", side_effect=RuntimeError("no groups")), \
            _env(USER="coverage-user"):
        ok &= _check(len(helpers.get_anon_user_id()) == 32, "anon id without groups")

    class Response:
        def __enter__(self):
            return self

        def __exit__(self, *exc):
            return False

        def read(self, _n=-1):
            return b"ok"

    with mock.patch.object(helpers.urllib.request, "urlopen", return_value=Response()):
        ok &= _check(helpers._urlopen_quiet("http://example.invalid") is True, "_urlopen_quiet success")
    with mock.patch.object(helpers.urllib.request, "urlopen", side_effect=urllib.error.URLError("x")):
