def _install_hyperopt_stub() -> None:
    """Tiny hyperopt stand-in so the TPE tests also run without the real package."""
    module = types.ModuleType("hyperopt")
    module.STATUS_OK = "ok"

    class Space:
        def __init__(self, kind, **kwargs):
            self.kind = kind
            self.kwargs = kwargs

    def quniform(name, lo, hi, _q):
        return Space("int", name=name, lo=lo, hi=hi)

    def uniform(name, lo, hi):
        return Space("float", name=name, lo=lo, hi=hi)

    def choice(name, values):
        return Space("choice", name=name, values=values)

    class Trials:
        def __init__(self):
            self.trials = []

        @property
        def best_trial(self):
            return min(self.trials, key=lambda t: t["result"].get("loss", 0))

    def fmin(fn, space, algo, trials, max_evals, verbose, rstate):
        del algo, verbose
        rng = rstate
        for _ in range(max_evals):
            vals = {}
            for name, spec in space.items():
                if spec.kind == "int":
                    vals[name] = [int(round(rng.uniform(spec.kwargs["lo"], spec.kwargs["hi"])))]
                elif spec.kind == "float":
                    vals[name] = [rng.uniform(spec.kwargs["lo"], spec.kwargs["hi"])]
                else:
                    vals[name] = [rng.integers(len(spec.kwargs["values"]))]
            result = fn({name: value[0] for name, value in vals.items()})
            trials.trials.append({"misc": {"vals": vals}, "result": result})
        return trials.best_trial

    module.hp = SimpleNamespace(quniform=quniform, uniform=uniform, choice=choice)
    module.tpe = SimpleNamespace(suggest=lambda *_a, **_k: None)
    module.Trials = Trials
    module.fmin = fmin
    sys.modules["hyperopt"] = module


