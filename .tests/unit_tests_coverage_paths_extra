def _check(condition: bool, message: str) -> bool:
    if not condition:
        red_text(f"FAIL: {message}")
    return condition


@contextlib.contextmanager
def _env(**values):
    old = {key: os.environ.get(key) for key in values}
    try:
        for key, value in values.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value
        yield
    finally:
        for key, value in old.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value


def _expect_exit(fn, code=None) -> bool:
    try:
        fn()
    except SystemExit as exc:
        return code is None or exc.code == code
    except Exception:
        return False
    return False


def _args(**kwargs):
    values = {
        "run_dir": _PLOT_TMP,
        "save_to_file": "0",
        "min": None,
        "max": None,
        "allow_axes": [],
        "no_legend": False,
        "merge_with_previous_runs": [],
    }
    values.update(kwargs)
    return SimpleNamespace(**values)


def _write_run(root: Path, *, result=("result", [1.0, 2.0, 3.0]), extra=None) -> Path:
    run = root / "run"
    run.mkdir(parents=True, exist_ok=True)
    data = {result[0]: result[1], "x": list(range(len(result[1])))}
    if extra:
        data.update(extra)
    pd.DataFrame(data).to_csv(run / "results.csv")
    return run


