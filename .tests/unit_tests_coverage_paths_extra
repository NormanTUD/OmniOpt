    fake_button = mock.MagicMock()
    fake_textboxes = [mock.MagicMock(), mock.MagicMock()]
    update = mock.MagicMock()
    with mock.patch.object(helpers, "Button", return_value=fake_button) as button_cls, \
            mock.patch.object(helpers, "TextBox", side_effect=fake_textboxes) as textbox_cls:
        widgets = helpers.create_widgets(
            [fake_plt, None, None, None, _args(min="1.5", max=2), None, None, update]
        )
    ok = _check(len(widgets) == 5, "create_widgets must return five widgets")
    ok &= _check(fake_button.on_clicked.call_args[0][0] is update, "button callback")
    ok &= _check(button_cls.call_count == 1 and textbox_cls.call_count == 2, "widget counts")
    ok &= _check(
        textbox_cls.call_args_list[0].kwargs["initial"] == "1.5",
        "minimum textbox initial value",
    )
    ok &= _check(
