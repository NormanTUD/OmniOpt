        try:
            share.write_bundle_zip(bad, root / "bad.zip")
            ok = False
        except ValueError:
            pass
        try:
            share.write_bundle_zip(
                manifest, root / "missing.zip", local_paths={"results.csv": root / "missing"}
            )
            ok = False
        except FileNotFoundError:
            pass
    return ok


