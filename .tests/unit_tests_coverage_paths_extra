def test_helpers_colors_legends_and_merging() -> bool:
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        run = _write_run(root)
        args = _args(run_dir=str(run), no_legend=False)
        fig = mock.MagicMock()
        cbar = fig.colorbar.return_value
        helpers.show_legend(args, fig, object(), [])
        ok = _check(cbar.set_label.called, "legend label set")
        fig.colorbar.side_effect = RuntimeError("no legend")
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            helpers.show_legend(args, fig, object(), [])
        ok &= _check(True, "legend exception branch")

        df = pd.read_csv(run / "results.csv", index_col=0)
        (run / "result_min_max.txt").write_text("min\n")
        fake_plt = SimpleNamespace(Normalize=lambda lo, hi: ("norm", lo, hi))
        cmap, norm, colors = helpers.get_color_list(df, args, fake_plt, str(run / "results.csv"))
        ok &= _check(cmap is not None and norm[0] == "norm", "color list")
        (run / "result_min_max.txt").write_text("max\n")
        _, _, colors_max = helpers.get_color_list(df, args, fake_plt, str(run / "results.csv"))
        ok &= _check((colors_max <= 0).all(), "maximize negates colors")

        with mock.patch.object(helpers, "get_colors", return_value=None):
            ok &= _check(_expect_exit(
                lambda: helpers.get_color_list(df, args, fake_plt, str(run / "results.csv")), 3
            ), "color list rejects None colors")
        bad_plt = SimpleNamespace(Normalize=mock.MagicMock(side_effect=RuntimeError("bad")))
        ok &= _check(_expect_exit(
            lambda: helpers.get_color_list(df, args, bad_plt, str(run / "results.csv")), 16
        ), "color list rejects bad values")

        prev = root / "prev"
        prev.mkdir()
        pd.DataFrame({"result": [4.0, 5.0], "x": [10, 11]}).to_csv(prev / "results.csv")
        prev_df = pd.read_csv(prev / "results.csv", index_col=0)
