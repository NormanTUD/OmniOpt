def _build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="omniopt_share",
        description="Share OmniOpt runs.",
        add_help=False,
    )
    p.add_argument("--help", action="store_true")
    p.add_argument("--update", action="store_true",
                   help="Update a previously-shared run.")
    p.add_argument("--debug", action="store_true")
    p.add_argument("--no_color", action="store_true")
    p.add_argument("--force", action="store_true",
                   help="Ignore the incremental cache and re-send everything.")
    p.add_argument("--include_state_files", action="store_true",
                   help="Also share state_files/*.json/csv/txt (large "
                        "checkpoints/model snapshots; normally skipped).")
    p.add_argument("--timeout", type=float, default=DEFAULT_POST_TIMEOUT,
                   help=f"HTTP timeout in seconds (default: {DEFAULT_POST_TIMEOUT}).")
    p.add_argument("--username", default=None)
    p.add_argument("--password", default=None)
    p.add_argument(
        "--dont_send_singleruns", "--no_single_run_logs",
        dest="dont_send_singleruns", action="store_true",
        help="Do not share any single-run logs (alias: --no_single_run_logs).",
    )
    p.add_argument("--send_all_single_runs", action="store_true",
                   help="Share all single-run logs, including successful ones "
                        "(default: only failed/interrupted logs).")
    p.add_argument("--send_all_failed_logs", action="store_true",
                   help="Do not randomly sample failed logs when they exceed "
                        f"{_format_size(MAX_FAILED_LOG_BYTES)}.")
    p.add_argument("--outfile", default=None)
    p.add_argument("run_dirs", nargs="*", default=[],
                   help="One or more run directories to share.")
    return p


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    args = _build_parser().parse_args(list(argv))
    # Convenience: invert --dont_send_singleruns into a positive bool.
    args.send_single_runs = not args.dont_send_singleruns
    return args


