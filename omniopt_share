def _read_username_from_cache() -> Optional[str]:
    if DONT_ASK_FILE.exists() and USERNAME_FILE.exists():
        cached = USERNAME_FILE.read_text(encoding="utf-8").strip()
        if is_valid_username(cached):
            return cached
    return None


def _resolve_username(args: argparse.Namespace) -> Optional[str]:
    if args.username:
        if not is_valid_username(args.username):
            print(f"Invalid username: {args.username!r}", file=sys.stderr)
            return None
        return args.username
    return _read_username_from_cache()


def _post_manifest(base_url: str, manifest: Dict[str, Any],
                   bundle_zip: Path, args: argparse.Namespace) -> Tuple[int, str]:
    """Upload ``manifest.json`` + ``bundle.zip`` as multipart POST.

    Returns ``(exit_code, body)``.  Falls back to a JSON POST when no
    bundle is present.
    """
    url = (
        f"{base_url}/share_internal.php"
        f"?user_id={manifest['user_id']}"
        f"&experiment_name={manifest['experiment_name']}"
    )
    if manifest["update"]:
        url += "&update=1"
    if manifest["update_uuid"]:
        url += f"&update_uuid={manifest['update_uuid']}"
    if manifest["password"]:
        url += f"&password={manifest['password']}"

    boundary = "----omniopt-share-" + os.urandom(8).hex()
    content_length, body = _build_multipart_stream(boundary, manifest, bundle_zip)
    req = urllib.request.Request(
        url,
        data=body,
        headers={
            "Content-Type": f"multipart/form-data; boundary={boundary}",
            "Content-Length": str(content_length),
        },
        method="POST",
    )
    timeout = float(getattr(args, "timeout", DEFAULT_POST_TIMEOUT) or DEFAULT_POST_TIMEOUT)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, resp.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode("utf-8", errors="replace")
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        return 7, f"Connection error: {e}"


def _build_multipart_stream(
    boundary: str, manifest: Dict[str, Any], bundle_zip: Path
) -> Tuple[int, Iterable[bytes]]:
    """Return ``(content_length, chunks)`` for a streaming multipart body.

    The zip is streamed from disk in 1 MiB chunks.  This keeps memory usage
    constant even for very large run directories (the old implementation read
    the whole ``bundle.zip`` into a single ``bytes`` object, then copied it
    again while building the request body).
    """
    prefix = (
        f"--{boundary}\r\n"
        'Content-Disposition: form-data; name="manifest"\r\n'
        "Content-Type: application/json\r\n"
        "\r\n"
    ).encode()
    manifest_bytes = json.dumps(manifest).encode()
    middle = (
        f"\r\n--{boundary}\r\n"
        'Content-Disposition: form-data; name="bundle"; filename="bundle.zip"\r\n'
        "Content-Type: application/zip\r\n"
        "\r\n"
    ).encode()
    suffix = f"\r\n--{boundary}--\r\n".encode()
    zip_size = bundle_zip.stat().st_size
    content_length = (
        len(prefix) + len(manifest_bytes) + len(middle) + zip_size + len(suffix)
    )

    def chunks() -> Iterable[bytes]:
        yield prefix
        yield manifest_bytes
        yield middle
        with bundle_zip.open("rb") as fh:
            for chunk in iter(lambda: fh.read(1 << 20), b""):
                yield chunk
        yield suffix

    return content_length, chunks()


def _resolve_base_url() -> str:
    if BASE_URL_FILE.exists():
        return BASE_URL_FILE.read_text(encoding="utf-8").strip() or DEFAULT_BASE_URL
    return DEFAULT_BASE_URL
def _share_one_with(
    args: argparse.Namespace,
    user_id: str,
    run_dir: str,
    base_url: str,
    *,
    post_manifest: Callable[..., Tuple[int, str]],
) -> int:
    """Variant of :func:`_share_one` that takes an injected HTTP
    transport for testing."""
    if not os.path.isdir(run_dir):
        print(f"{run_dir} does not exist", file=sys.stderr)
        return 1

    experiment_name = os.path.basename(
        os.path.dirname(os.path.abspath(run_dir))
    )
    send_single_runs = not getattr(args, "dont_send_singleruns", False)
    send_all_single_runs = bool(getattr(args, "send_all_single_runs", False))
    send_all_failed_logs = bool(getattr(args, "send_all_failed_logs", False))
    include_state_files = bool(getattr(args, "include_state_files", False))

    run_uuid: Optional[str] = None
    run_uuid_path = Path(run_dir) / "state_files" / "run_uuid"
    if run_uuid_path.is_file():
        try:
            run_uuid = run_uuid_path.read_text(encoding="utf-8").strip() or None
        except OSError:
            run_uuid = None

    all_files = collect_shareable_files(
        run_dir,
        send_single_runs=send_single_runs,
        include_state_files=include_state_files,
    )
    if not all_files:
        print(f"Could not find any files in {run_dir}", file=sys.stderr)
        return 1

    successful_logs: List[Dict[str, Any]] = []
    omitted_failed_logs: List[Dict[str, Any]] = []
    files_for_selection = all_files
    if send_single_runs and not send_all_single_runs:
        regular_files, failed_logs, successful_logs = _split_single_run_logs(all_files)
        if not send_all_failed_logs:
            failed_size = sum(_file_size(f) for f in failed_logs)
            if failed_size > MAX_FAILED_LOG_BYTES:
                failed_logs, omitted_failed_logs, kept_size = _limit_failed_logs(
                    failed_logs,
                    MAX_FAILED_LOG_BYTES,
                    run_uuid or str(Path(run_dir).resolve()),
                )
                print(
                    f"Failed logs total {_format_size(failed_size)}; selected "
                    f"{_format_size(kept_size)} (cap "
                    f"{_format_size(MAX_FAILED_LOG_BYTES)}). "
                    "Use --send_all_failed_logs to send all of them.",
                    file=sys.stderr,
                )
        files_for_selection = regular_files + failed_logs

    omitted_folders: Dict[str, str] = {}
    for f in successful_logs:
        parts = str(f["archive_path"]).split("/")
        omitted_folders["/".join(parts[:2])] = "successful"
    for f in omitted_failed_logs:
        parts = str(f["archive_path"]).split("/")
        omitted_folders["/".join(parts[:2])] = "log cap"

    metadata_entry = _write_omitted_logs_metadata(
        run_dir,
        user_id,
        omitted_folders,
        single_run_logs_skipped=not send_single_runs,
    )
    all_files = [
        f for f in all_files if f["archive_path"] != OMITTED_LOGS_FILENAME
    ]
    files_for_selection = [
        f for f in files_for_selection
        if f["archive_path"] != OMITTED_LOGS_FILENAME
    ]
    if metadata_entry is not None:
        all_files.append(metadata_entry)
        files_for_selection.append(metadata_entry)

    if not files_for_selection:
        print(f"Could not find any files in {run_dir}", file=sys.stderr)
        return 1

    cache_path = _cache_file_path(
        run_dir, user_id, experiment_name, base_url, run_uuid
    )
    cache = _load_cache(cache_path)
    incremental = (
        bool(getattr(args, "update", False))
        and not bool(getattr(args, "force", False))
        and bool(cache)
    )

    if incremental:
        files_to_send, pre_states = _split_changed_files(files_for_selection, cache)
        if not files_to_send:
            _print_size_breakdown(
                all_files,
                files_to_send,
                successful_logs,
                send_all_single_runs,
                omitted_failed_logs,
            )
            print(
                f"Nothing changed in {run_dir}; skipping upload.",
                file=sys.stderr,
            )
            return 0
    else:
        files_to_send = files_for_selection
        pre_states = {}
        for f in files_for_selection:
            try:
                pre_states[f["archive_path"]] = _file_state(Path(f["local_path"]))
            except OSError:
                continue

    _print_size_breakdown(
        all_files,
        files_to_send,
        successful_logs,
        send_all_single_runs,
        omitted_failed_logs,
    )

    manifest = build_manifest(
        run_dir=run_dir,
        user_id=user_id,
        experiment_name=experiment_name,
        update=bool(getattr(args, "update", False)),
        update_uuid=run_uuid,
        password=getattr(args, "password", None),
        send_single_runs=send_single_runs,
        include_state_files=include_state_files,
        files=files_to_send,
    )

    if not manifest["files"]:
        print(f"Could not find any files in {run_dir}", file=sys.stderr)
        return 1

    # Use a single temporary ZIP file instead of a temporary directory.  The
    # old ``mkdtemp(prefix="oo_share_")`` created an ``oo_share_*`` folder on
    # every share (and left it behind if the process was interrupted).
    zip_fd, zip_name = tempfile.mkstemp(prefix="omniopt_share_", suffix=".zip")
    os.close(zip_fd)
    zip_path = Path(zip_name)
    try:
        try:
            write_bundle_zip(manifest, zip_path, source_dir=run_dir)
        except ValueError as e:
            print(f"Refusing to share: {e}", file=sys.stderr)
            return 1

        total_size = sum(int(f["size"]) for f in manifest["files"])
        if getattr(args, "debug", False) or total_size >= (1 << 20):
            print(
                f"Uploading {len(manifest['files'])} file(s), "
                f"{total_size / (1 << 20):.1f} MiB"
                + (" (incremental update)" if incremental else "")
                + "...",
                file=sys.stderr,
            )

        status, body = post_manifest(base_url, manifest, zip_path, args)

        if status != 200 or "Error" in body:
            print(body, file=sys.stderr)
            if status == 7:
                print(
                    "Exit code 7 means the server was not reachable. "
                    "Are you online? Is the server properly started?",
                    file=sys.stderr,
                )
            return status if status != 200 else 1

        _update_cache(
            cache_path,
            cache,
            manifest,
            pre_states,
            run_dir,
            replace=not incremental,
        )
        print(body)
        return 0
    finally:
        try:
            zip_path.unlink()
        except FileNotFoundError:
            pass


def _share_one(
    args: argparse.Namespace,
    user_id: str,
    run_dir: str,
    base_url: str,
) -> int:
    """Share a single run_dir; returns 0 on success, non-zero on error."""
    return _share_one_with(
        args, user_id, run_dir, base_url,
        post_manifest=_post_manifest,
    )


def main(
    argv: Optional[Sequence[str]] = None,
    *,
    post_manifest: Optional[Callable[..., Tuple[int, str]]] = None,
) -> int:
    args = parse_args(argv if argv is not None else sys.argv[1:])
    if args.help:
        _print_help()
        return 0
    if not args.run_dirs:
        print("Please run with at least one folder as argument", file=sys.stderr)
        return 1

    user_id = _resolve_username(args)
    if not user_id:
        print("No username (use --username or run interactively once)", file=sys.stderr)
        return 1

    base_url = _resolve_base_url()

    last_rc = 0
    for run_dir in args.run_dirs:
        if post_manifest is not None:
            rc = _share_one_with(args, user_id, run_dir, base_url,
                                post_manifest=post_manifest)
        else:
            rc = _share_one(args, user_id, run_dir, base_url)
        if rc != 0:
            last_rc = rc
    return last_rc


# Legacy alias kept for tests / external callers that still use the
# single-dir API.
_share_one_run_dir = _share_one


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
